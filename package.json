{
  "name": "veritio-website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Public website and documentation shell for Veritio.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && bun run build:agent-docs",
    "preview": "astro preview",
    "check": "astro check",
    "test": "bun test tests/site-contract.test.ts tests/billing-catalog-verifier.test.ts",
    "test:built": "bun test tests/build-output.test.ts",
    "verify": "bun run test && bun run verify:billing-catalog && bun run verify:examples && bun run check && bun run build && bun run test:built",
    "verify:billing-catalog": "bun run scripts/verify-billing-catalog.ts",
    "verify:examples": "bun run scripts/verify-examples.ts",
    "build:agent-docs": "bun run scripts/build-agent-docs.ts",
    "images:alt": "node scripts/generate-alt-images.mjs",
    "remotion:studio": "bun --cwd remotion run studio",
    "remotion:render": "bun --cwd remotion run render",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "0.41.7",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "@veritio/core": "0.4.7",
    "@veritio/storage": "0.4.7",
    "astro": "^7.0.9",
    "pagefind": "1.5.2",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "1.3.14",
    "@types/turndown": "5.0.6",
    "axe-core": "4.13.0",
    "turndown": "7.2.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.111.0",
    "yaml": "2.9.0"
  }
}
