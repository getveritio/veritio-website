---
/**
 * Renders the privacy choice UI shared by marketing and documentation pages.
 * Consent behavior lives in ConsentScript so Starlight client-side navigation
 * cannot strand newly rendered controls without event handlers.
 */
import { localeFromPathname, cookieBannerStrings } from '../i18n'

const locale = localeFromPathname(Astro.url.pathname)
const t = cookieBannerStrings[locale]
---

<div
  id="cookie-banner"
  hidden
  role="region"
  aria-label={t.ariaLabel}
  class="cookie-banner"
>
  <div class="cookie-banner__inner">
    <p>
      {t.message}{' '}
      <a href="/legal/privacy/">{t.privacy}</a>
    </p>
    <div class="cookie-banner__actions">
      <button type="button" id="cookie-decline" onclick="window.VeritioConsent?.decline()">{t.decline}</button>
      <button type="button" id="cookie-accept" class="cookie-banner__accept" onclick="window.VeritioConsent?.accept()">{t.accept}</button>
    </div>
  </div>
</div>

<style>
  .cookie-banner[hidden] { display: none; }
  .cookie-banner { position: fixed; z-index: 100; inset: auto 0 0; border-top: 1px solid var(--color-line-strong, var(--sl-color-hairline-shade)); background: var(--color-surface, var(--sl-color-bg)); box-shadow: 0 -4px 24px rgb(0 0 0 / 0.1); color: var(--color-ink-soft, var(--sl-color-gray-2)); }
  .cookie-banner__inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; width: min(100% - 2rem, 1180px); margin-inline: auto; padding-block: 1rem; }
  .cookie-banner p { max-width: 48rem; margin: 0; font-family: var(--font-serif, var(--sl-font)); font-size: 0.88rem; line-height: 1.55; }
  .cookie-banner a { color: var(--color-ink, var(--sl-color-white)); text-decoration: underline; text-underline-offset: 0.16em; }
  .cookie-banner__actions { display: flex; flex: none; gap: 0.65rem; }
  .cookie-banner button { cursor: pointer; border: 1px solid var(--color-line-strong, var(--sl-color-gray-4)); background: transparent; color: var(--color-ink, var(--sl-color-white)); padding: 0.68rem 0.9rem; font-family: var(--font-mono, var(--sl-font-mono)); font-size: 0.72rem; }
  .cookie-banner .cookie-banner__accept { border-color: var(--color-evergreen, var(--sl-color-accent)); background: var(--color-evergreen, var(--sl-color-accent)); color: var(--color-surface, var(--sl-color-black)); }
  @media (max-width: 42rem) { .cookie-banner__inner { align-items: stretch; flex-direction: column; } .cookie-banner__actions { justify-content: flex-end; } }
</style>
