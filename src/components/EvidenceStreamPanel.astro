---
/**
 * Static evidence-stream reference for §01. The poster preserves the product
 * proof without shipping media-control or viewport-observer JavaScript.
 */
interface Props {
  caption?: string
}

const {
  caption = 'Evidence stream · demonstration data',
} = Astro.props
---

<figure class="evidence-stream-panel m-0">
  <div
    class="relative overflow-hidden rounded-[12px] border border-line-strong bg-[#09090b] shadow-[0_24px_60px_rgba(0,0,0,0.12)]"
  >
    <img
      src="/media/evidence-stream-poster.jpg"
      width="720"
      height="496"
      alt=""
      decoding="async"
      class="block h-auto w-full"
    />
  </div>
  <figcaption class="mt-3 font-mono text-[11.5px] leading-relaxed tracking-[0.02em] text-ink-muted">
    {caption}
  </figcaption>
</figure>
