---
/**
 * Document colophon footer: ruled columns, mono headings, and the standing
 * compliance disclaimer (required copy — Veritio provides evidence support,
 * never automatic compliance). Shared by all pages; static.
 */
import { localeFromPathname, localizePath, footerStrings, cookieBannerStrings } from '../i18n'

const year = 2026
const locale = localeFromPathname(Astro.url.pathname)
const t = footerStrings[locale]
const cookieSettingsLabel = cookieBannerStrings[locale].settings
---

<footer class="border-t border-line-strong bg-surface-sunken">
  <div class="container grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <strong class="text-[19px] font-semibold tracking-tight text-ink">Veritio</strong>
      <p class="mt-3 max-w-xs text-[15px] leading-relaxed text-ink-muted">
        {t.blurb}
      </p>
    </div>

    <div>
      <h3 class="font-mono text-[11px] font-medium uppercase tracking-[0.18em] text-ink-muted">
        {t.product}
      </h3>
      <ul class="mt-4 space-y-2 text-[15px]">
        <li><a class="text-ink-soft no-underline hover:text-accent" href={localizePath('/', locale) === '/' ? '/' : `${localizePath('/', locale)}/`}>Overview</a></li>
        <li><a class="text-ink-soft no-underline hover:text-accent" href="/product/">Product</a></li>
        <li><a class="text-ink-soft no-underline hover:text-accent" href={localizePath('/cloud', locale) + '/'}>Cloud</a></li>
        <li><a class="text-ink-soft no-underline hover:text-accent" href="/examples/">Examples</a></li>
        <li><a class="text-ink-soft no-underline hover:text-accent" href="/alternatives/">Comparisons</a></li>
        <li><a class="text-ink-soft no-underline hover:text-accent" href="/changelog/">Changelog</a></li>
      </ul>
    </div>

    <div>
      <h3 class="font-mono text-[11px] font-medium uppercase tracking-[0.18em] text-ink-muted">
        {t.openSource}
      </h3>
      <ul class="mt-4 space-y-2 text-[15px]">
        <li>
          <a
            class="text-ink-soft no-underline hover:text-accent"
            href="https://github.com/getveritio/veritio"
            target="_blank"
            rel="noopener noreferrer">GitHub repository</a>
        </li>
        <li><a class="text-ink-soft no-underline hover:text-accent" href="/open-source/">Open-source stack</a></li>
        <li><a class="text-ink-soft no-underline hover:text-accent" href="/docs/ai/agent-events/">Connect Claude Code &amp; Codex</a></li>
      </ul>
    </div>

    <div>
      <h3 class="font-mono text-[11px] font-medium uppercase tracking-[0.18em] text-ink-muted">
        {t.legal}
      </h3>
      <ul class="mt-4 space-y-2 text-[15px]">
        <li><a class="text-ink-soft no-underline hover:text-accent" href="/legal/imprint/">Imprint (Impressum)</a></li>
        <li><a class="text-ink-soft no-underline hover:text-accent" href="/legal/terms/">Terms of Service</a></li>
        <li><a class="text-ink-soft no-underline hover:text-accent" href="/legal/privacy/">Privacy Policy</a></li>
        <li><a class="text-ink-soft no-underline hover:text-accent" href="/legal/dpa/">Data Processing Agreement</a></li>
        <li>
          <button
            type="button"
            data-cookie-settings
            onclick="window.VeritioConsent?.settings(this)"
            class="cursor-pointer text-ink-soft transition-colors hover:text-accent"
          >{cookieSettingsLabel}</button>
        </li>
      </ul>
      <p class="mt-4 max-w-xs text-[13px] leading-relaxed text-ink-muted">
        {t.disclaimer}
      </p>
    </div>
  </div>

  <div class="container flex flex-col gap-2 border-t border-line py-6 font-mono text-[11px] uppercase tracking-[0.12em] text-ink-muted sm:flex-row sm:items-center sm:justify-between">
    <span>© {year} Veritio</span>
  </div>
</footer>
