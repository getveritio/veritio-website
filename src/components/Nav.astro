---
/**
 * Site masthead (Aug 2026 redesign, per approved concept):
 * - Desktop: floating rounded pill bar — serif sentence-case links with a
 *   raised-tile + underline active state, EN dropdown (details/summary, no
 *   JS), Sign in, outlined GitHub button, solid "Start free" CTA.
 * - Mobile: evergreen open-source banner on top, logo + hamburger row, and a
 *   full-screen evergreen menu overlay (small inline script toggles it;
 *   the rest of the nav stays build-time only).
 * Active state is computed at build time from the pathname.
 */
import {
  localeFromPathname,
  basePath,
  localizePath,
  translatedPaths,
  navStrings,
  type Locale,
} from '../i18n'

const { pathname } = Astro.url
const locale = localeFromPathname(pathname)
const pageBase = basePath(pathname)
const t = navStrings[locale]

const links = [
  { href: localizePath('/', locale), base: '/', label: t.overview },
  { href: localizePath('/cloud', locale), base: '/cloud', label: t.cloud },
  { href: localizePath('/pricing', locale), base: '/pricing', label: t.pricing },
  { href: '/docs', base: '/docs', label: t.docs },
  { href: '/examples', base: '/examples', label: t.examples },
]
const isActive = (base: string) =>
  base === '/' ? pageBase === '/' : pageBase.startsWith(base)

// Language switcher: link to this page's translation when it exists, else
// to the locale's home page.
const switchTarget = (l: Locale) =>
  translatedPaths.includes(pageBase) ? localizePath(pageBase, l) : localizePath('/', l)
const langs: Locale[] = ['en', 'de', 'ko']
// Round flags from public/flags (circle-flags, MIT — see README there).
const flagOf: Record<Locale, string> = { en: '/flags/gb.svg', de: '/flags/de.svg', ko: '/flags/kr.svg' }

const ossRepo = 'https://github.com/getveritio/veritio'
const consoleUrl = 'https://console.getveritio.com/login'
const barShadow = 'lg:shadow-[0_1px_2px_rgba(16,35,27,0.05),0_16px_40px_-16px_rgba(16,35,27,0.14)]'
---

<!-- Mobile-only open-source banner -->
<div class="flex items-center justify-between gap-4 bg-surface-invert px-4 py-2.5 lg:hidden">
  <p class="flex min-w-0 items-center gap-2 text-[12.5px] leading-snug text-surface/90">
    <svg class="shrink-0 text-surface/80" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5 19 6v5.2c0 4.3-2.9 7.2-7 8.8-4.1-1.6-7-4.5-7-8.8V6l7-2.5z"/></svg>
    <span class="truncate">{t.banner}</span>
  </p>
  <a
    href={ossRepo}
    target="_blank"
    rel="noopener noreferrer"
    class="shrink-0 text-[12.5px] font-medium text-surface no-underline"
  >{t.viewOnGitHub} ↗</a>
</div>

<header class="sticky top-0 z-50">
  <div class="lg:mx-auto lg:max-w-[1180px] lg:px-gutter lg:pt-4">
    <nav
      class:list={[
        'border-b border-line-strong bg-surface lg:rounded-2xl lg:border lg:border-line lg:bg-surface-raised',
        barShadow,
      ]}
    >
      <div class="flex items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-5 lg:py-3">
        <a href={localizePath('/', locale)} class="flex items-center gap-2.5 no-underline" aria-label="Veritio home">
          <span class="grid h-8 w-8 place-items-center rounded-md bg-evergreen text-surface" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <circle cx="3.5" cy="3.5" r="2" fill="currentColor" />
              <circle cx="12.5" cy="3.5" r="2" fill="currentColor" />
              <circle cx="8" cy="12.5" r="2" fill="currentColor" />
              <path d="M3.5 3.5 8 12.5 12.5 3.5" stroke="currentColor" stroke-width="1.2" />
            </svg>
          </span>
          <strong class="text-[21px] font-semibold tracking-tight text-ink">Veritio</strong>
        </a>

        <!-- Desktop links -->
        <div class="hidden items-center gap-1 lg:flex">
          {
            links.map((link) => (
              <a
                href={link.href}
                class:list={[
                  'relative rounded-lg px-3.5 py-2 text-[15px] no-underline transition-colors',
                  isActive(link.base)
                    ? 'bg-surface-sunken font-medium text-ink after:absolute after:inset-x-3.5 after:-bottom-[13px] after:h-[2px] after:bg-ink'
                    : 'text-ink-soft hover:bg-surface-sunken/50 hover:text-ink',
                ]}
                aria-current={isActive(link.base) ? 'page' : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </div>

        <!-- Desktop right cluster -->
        <div class="hidden items-center gap-4 lg:flex">
          <span class="h-5 w-px bg-line" aria-hidden="true"></span>

          <details class="relative">
            <summary class="flex cursor-pointer list-none items-center gap-2 rounded-lg px-2 py-1.5 text-[14px] font-medium text-ink-soft transition-colors hover:text-ink [&::-webkit-details-marker]:hidden">
              <img src={flagOf[locale]} alt="" width="17" height="17" class="rounded-full" />
              {locale.toUpperCase()}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class:list={['absolute right-0 top-full z-10 mt-2 w-32 rounded-lg border border-line bg-surface-raised p-1', barShadow]}>
              {
                langs.map((l) => (
                  <a
                    href={switchTarget(l)}
                    hreflang={l}
                    class:list={[
                      'flex items-center gap-2.5 rounded-md px-3 py-2 text-[13.5px] no-underline transition-colors',
                      l === locale ? 'bg-surface-sunken font-medium text-ink' : 'text-ink-soft hover:bg-surface-sunken/60 hover:text-ink',
                    ]}
                  >
                    <img src={flagOf[l]} alt="" width="17" height="17" class="rounded-full" />
                    {l.toUpperCase()}
                  </a>
                ))
              }
            </div>
          </details>

          <span class="h-5 w-px bg-line" aria-hidden="true"></span>

          <a
            href={consoleUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[15px] text-ink-soft no-underline transition-colors hover:text-ink"
          >{t.signIn}</a>

          <a
            href={ossRepo}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 rounded-lg border border-line-strong px-3.5 py-2 text-[14px] font-medium text-ink no-underline transition-colors hover:border-ink"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
            GitHub
          </a>

          <a
            href={consoleUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 rounded-lg bg-evergreen px-4 py-2 text-[14px] font-medium text-surface no-underline transition-colors hover:bg-accent-strong"
          >
            {t.startFree}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
          </a>
        </div>

        <!-- Mobile hamburger -->
        <button
          type="button"
          data-nav-open
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={t.openMenu}
          class="grid h-10 w-10 place-items-center rounded-lg border border-line-strong bg-surface text-ink lg:hidden"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </nav>
  </div>
</header>

<!-- Mobile full-screen menu -->
<div id="mobile-menu" data-nav-menu class="fixed inset-0 z-[70] hidden overflow-y-auto bg-surface-invert lg:hidden" role="dialog" aria-modal="true" aria-label={t.menu}>
  <div class="flex min-h-full flex-col px-5 pb-10 pt-4">
    <div class="flex items-center justify-between">
      <a href={localizePath('/', locale)} class="flex items-center gap-2.5 no-underline" aria-label="Veritio home">
        <span class="grid h-8 w-8 place-items-center rounded-md bg-surface text-evergreen" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <circle cx="3.5" cy="3.5" r="2" fill="currentColor" />
            <circle cx="12.5" cy="3.5" r="2" fill="currentColor" />
            <circle cx="8" cy="12.5" r="2" fill="currentColor" />
            <path d="M3.5 3.5 8 12.5 12.5 3.5" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </span>
        <strong class="text-[21px] font-semibold tracking-tight text-surface">Veritio</strong>
      </a>
      <button
        type="button"
        data-nav-close
        aria-label={t.closeMenu}
        class="grid h-10 w-10 place-items-center rounded-lg border border-surface/25 text-surface"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>

    <span class="mt-8 inline-block w-fit rounded-md bg-surface/10 px-2.5 py-1 font-mono text-[10.5px] font-semibold uppercase tracking-[0.16em] text-surface/70">{t.menu}</span>

    <nav class="mt-2 flex flex-col">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'flex items-center justify-between border-b border-surface/10 py-4 text-[19px] no-underline',
              isActive(link.base)
                ? 'rounded-lg border border-surface/15 bg-surface/5 px-4 font-medium text-[#a9d5be]'
                : 'text-surface',
            ]}
            aria-current={isActive(link.base) ? 'page' : undefined}
          >
            {link.label}
            <svg class="text-surface/50" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
          </a>
        ))
      }
    </nav>

    <div class="mt-6 flex flex-col">
      <a href={consoleUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between border-b border-surface/10 py-4 text-[17px] text-surface no-underline">
        <span class="flex items-center gap-3">
          <svg class="text-surface/70" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c.8-3.2 3.6-5 7-5s6.2 1.8 7 5"/></svg>
          {t.signIn}
        </span>
        <svg class="text-surface/50" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
      </a>
      <div class="flex items-center justify-between border-b border-surface/10 py-4 text-[17px] text-surface">
        <span class="flex items-center gap-3">
          <svg class="text-surface/70" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3z"/></svg>
          <span class="flex items-center gap-4">
            {
              langs.map((l) => (
                <a
                  href={switchTarget(l)}
                  hreflang={l}
                  class:list={[
                    'flex items-center gap-1.5 no-underline',
                    l === locale ? 'font-semibold text-[#a9d5be]' : 'text-surface/70',
                  ]}
                >
                  <img src={flagOf[l]} alt="" width="16" height="16" class="rounded-full" />
                  {l.toUpperCase()}
                </a>
              ))
            }
          </span>
        </span>
      </div>
    </div>

    <a
      href={ossRepo}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-8 flex items-center justify-between rounded-xl border border-surface/25 px-5 py-4 text-[16px] font-medium text-surface no-underline"
    >
      <span class="flex items-center gap-3">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
        {t.viewOnGitHub}
      </span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</div>

<script>
  // Mobile menu toggle — the only client JS in the nav. Locks body scroll
  // while open; Escape closes.
  const openBtn = document.querySelector<HTMLButtonElement>('[data-nav-open]')
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-nav-close]')
  const menu = document.querySelector<HTMLElement>('[data-nav-menu]')

  function setOpen(open: boolean) {
    if (!menu || !openBtn) return
    menu.classList.toggle('hidden', !open)
    openBtn.setAttribute('aria-expanded', String(open))
    document.body.style.overflow = open ? 'hidden' : ''
    if (open) closeBtn?.focus()
    else openBtn.focus()
  }

  openBtn?.addEventListener('click', () => setOpen(true))
  closeBtn?.addEventListener('click', () => setOpen(false))
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.classList.contains('hidden')) setOpen(false)
  })
</script>
