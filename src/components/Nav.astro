---
/**
 * Shared public-site masthead. It mirrors the documentation shell: a ruled,
 * paper-like bar with an OSS-first route order, persistent theme selection,
 * and a visually separate optional Cloud action.
 */
import {
  localeFromPathname,
  basePath,
  localizePath,
  translatedPaths,
  navStrings,
  type Locale,
} from '../i18n'
import ThemeToggle from './ThemeToggle.astro'

const { pathname } = Astro.url
const locale = localeFromPathname(pathname)
const pageBase = basePath(pathname)
const t = navStrings[locale]

const links = [
  { href: '/product/', base: '/product', label: t.product },
  { href: '/open-source/', base: '/open-source', label: t.openSource },
  { href: '/docs/', base: '/docs', label: t.docs },
  { href: '/examples/', base: '/examples', label: t.examples },
  { href: localizePath('/cloud', locale) + '/', base: '/cloud', label: t.cloud },
  { href: localizePath('/pricing', locale) + '/', base: '/pricing', label: t.pricing },
]
const isActive = (base: string) => pageBase.startsWith(base)
const switchTarget = (nextLocale: Locale) => {
  const target = translatedPaths.includes(pageBase) ? localizePath(pageBase, nextLocale) : localizePath('/', nextLocale)
  return target === '/' ? '/' : `${target}/`
}
const langs: Locale[] = ['en', 'de', 'ko']
const flagOf: Record<Locale, string> = { en: '/flags/gb.svg', de: '/flags/de.svg', ko: '/flags/kr.svg' }
---

<header class="site-header">
  <div class="site-header__inner">
    <a href={localizePath('/', locale) === '/' ? '/' : `${localizePath('/', locale)}/`} class="site-brand" aria-label="Veritio home">
      <img src="/favicon.svg" alt="" width="32" height="32" />
      <span>Veritio</span>
      <small>Evidence layer</small>
    </a>

    <nav class="site-links" aria-label="Primary navigation">
      {links.map((link) => (
        <a href={link.href} aria-current={isActive(link.base) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>

    <div class="site-actions">
      <details class="language-menu">
        <summary><img src={flagOf[locale]} alt="" width="16" height="16" />{locale.toUpperCase()}</summary>
        <div>
          {langs.map((lang) => <a href={switchTarget(lang)} hreflang={lang}>{lang.toUpperCase()}</a>)}
        </div>
      </details>
      <ThemeToggle />
      <a class="site-github" href="https://github.com/getveritio/veritio" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a class="site-cloud" href="https://console.getveritio.com/register" target="_blank" rel="noopener noreferrer">Start with Cloud ↗</a>
    </div>

    <details class="mobile-nav">
      <summary>{t.menu}</summary>
      <div class="mobile-nav__panel">
        <nav aria-label="Mobile navigation">
          {links.map((link) => <a href={link.href} aria-current={isActive(link.base) ? 'page' : undefined}>{link.label}</a>)}
        </nav>
        <div class="mobile-nav__utilities">
          <ThemeToggle />
          {langs.map((lang) => <a href={switchTarget(lang)} hreflang={lang}>{lang.toUpperCase()}</a>)}
        </div>
        <a class="site-cloud" href="https://console.getveritio.com/register" target="_blank" rel="noopener noreferrer">Start with Cloud ↗</a>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header { position: sticky; inset-block-start: 0; z-index: 50; border-block: 1px solid var(--color-line); background: color-mix(in srgb, var(--color-surface) 95%, transparent); backdrop-filter: blur(14px); }
  .site-header__inner { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 2rem; max-width: 1440px; min-height: 70px; margin-inline: auto; padding-inline: var(--spacing-gutter); }
  .site-brand { display: inline-flex; align-items: center; gap: 0.65rem; color: var(--color-ink); text-decoration: none; }
  .site-brand img { width: 2rem; height: 2rem; }
  .site-brand span { font-size: 1.25rem; font-weight: 650; }
  .site-brand small { border-inline-start: 1px solid var(--color-line-strong); padding-inline-start: 0.7rem; color: var(--color-ink-muted); font-family: var(--font-mono); font-size: 0.63rem; letter-spacing: 0.12em; text-transform: uppercase; white-space: nowrap; }
  .site-links { display: flex; align-items: center; justify-content: center; gap: 1.2rem; }
  .site-links a, .site-actions a, .language-menu summary { color: var(--color-ink-soft); font-family: var(--font-mono); font-size: 0.72rem; text-decoration: none; }
  .site-links a { padding-block: 1.55rem; border-block-end: 2px solid transparent; }
  .site-links a:hover, .site-links a[aria-current='page'] { color: var(--color-ink); border-block-end-color: var(--color-accent); }
  .site-actions { display: flex; align-items: center; justify-content: flex-end; gap: 0.85rem; }
  .language-menu { position: relative; }
  .language-menu summary { display: flex; cursor: pointer; list-style: none; align-items: center; gap: 0.4rem; }
  .language-menu summary::-webkit-details-marker { display: none; }
  .language-menu > div { position: absolute; inset-block-start: 2rem; inset-inline-end: 0; display: grid; min-width: 6rem; border: 1px solid var(--color-line); background: var(--color-surface-raised); padding: 0.35rem; box-shadow: 0 12px 28px rgb(18 35 27 / 0.12); }
  .language-menu > div a { padding: 0.5rem 0.65rem; }
  .site-actions .site-github { border-inline-start: 1px solid var(--color-line); padding-inline-start: 0.85rem; }
  .site-actions .site-cloud, .mobile-nav__panel .site-cloud { border: 1px solid var(--color-evergreen); background: var(--color-evergreen); color: var(--color-surface); padding: 0.72rem 0.9rem; }
  .mobile-nav { display: none; position: relative; }
  .mobile-nav > summary { cursor: pointer; border: 1px solid var(--color-line-strong); padding: 0.55rem 0.75rem; font-family: var(--font-mono); font-size: 0.72rem; list-style: none; }
  .mobile-nav > summary::-webkit-details-marker { display: none; }
  .mobile-nav__panel { position: fixed; inset: 70px 0 auto; display: grid; gap: 1.25rem; border-block-end: 1px solid var(--color-line-strong); background: var(--color-surface); padding: 1.25rem var(--spacing-gutter) 1.5rem; box-shadow: 0 18px 40px rgb(18 35 27 / 0.14); }
  .mobile-nav__panel nav { display: grid; }
  .mobile-nav__panel nav a { border-block-end: 1px solid var(--color-line); padding: 0.85rem 0; color: var(--color-ink); text-decoration: none; }
  .mobile-nav__utilities { display: flex; align-items: center; gap: 1rem; font-family: var(--font-mono); font-size: 0.72rem; }
  .mobile-nav__utilities a { color: var(--color-ink-soft); text-decoration: none; }

  @media (max-width: 1180px) {
    .site-header__inner { grid-template-columns: auto 1fr auto; }
    .site-links, .site-actions { display: none; }
    .mobile-nav { display: block; justify-self: end; }
  }
  @media (max-width: 480px) { .site-brand small { display: none; } }
</style>
