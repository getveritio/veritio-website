---
/**
 * Site masthead, styled as a document header: serif wordmark, mono uppercase
 * navigation, square-cornered GitHub action. Shared by all pages; active
 * state is computed at build time — no client JS.
 */
import {
  localeFromPathname,
  basePath,
  localizePath,
  translatedPaths,
  navStrings,
  type Locale,
} from '../i18n'

const { pathname } = Astro.url
const locale = localeFromPathname(pathname)
const pageBase = basePath(pathname)
const t = navStrings[locale]

const links = [
  { href: localizePath('/', locale), base: '/', label: t.overview },
  { href: localizePath('/cloud', locale), base: '/cloud', label: t.cloud },
  { href: localizePath('/pricing', locale), base: '/pricing', label: t.pricing },
  { href: '/docs', base: '/docs', label: t.docs },
  { href: '/examples', base: '/examples', label: t.examples },
]
const isActive = (base: string) =>
  base === '/' ? pageBase === '/' : pageBase.startsWith(base)

// Language switcher: link to this page's translation when it exists, else
// to the locale's home page.
const switchTarget = (l: Locale) =>
  translatedPaths.includes(pageBase) ? localizePath(pageBase, l) : localizePath('/', l)
const langs: Locale[] = ['en', 'de', 'ko']
---

<nav class="border-b border-line-strong bg-surface">
  <div class="container flex flex-wrap items-center justify-between gap-4 py-4">
    <a href="/" class="flex items-center gap-2.5 no-underline" aria-label="Veritio home">
      <span
        class="grid h-7 w-7 place-items-center bg-evergreen text-surface"
        aria-hidden="true"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <circle cx="3.5" cy="3.5" r="2" fill="currentColor" />
          <circle cx="12.5" cy="3.5" r="2" fill="currentColor" />
          <circle cx="8" cy="12.5" r="2" fill="currentColor" />
          <path d="M3.5 3.5 8 12.5 12.5 3.5" stroke="currentColor" stroke-width="1.2" />
        </svg>
      </span>
      <strong class="text-[20px] font-semibold tracking-tight text-ink">Veritio</strong>
    </a>

    <div class="flex items-center gap-6 font-mono text-[12px] font-medium uppercase tracking-[0.14em]">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'no-underline transition-colors hover:text-accent',
              isActive(link.base)
                ? 'border-b border-accent pb-0.5 text-accent'
                : 'text-ink-muted',
            ]}
            aria-current={isActive(link.base) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="https://console.getveritio.com/login"
        target="_blank"
        rel="noopener noreferrer"
        class="text-ink-muted no-underline transition-colors hover:text-accent"
      >
        {t.signIn}
      </a>
      <span class="flex items-center gap-1.5 text-[11px]" aria-label="Language">
        {
          langs.map((l, i) => (
            <>
              {i > 0 && <span class="text-line-strong">·</span>}
              <a
                href={switchTarget(l)}
                hreflang={l}
                class:list={[
                  'no-underline transition-colors hover:text-accent',
                  l === locale ? 'text-accent' : 'text-ink-muted',
                ]}
              >
                {l.toUpperCase()}
              </a>
            </>
          ))
        }
      </span>
      <a
        href="https://github.com/getveritio/veritio"
        target="_blank"
        rel="noopener noreferrer"
        class="border border-line-strong px-3.5 py-1.5 text-ink no-underline transition-colors hover:border-ink hover:bg-ink hover:text-surface"
      >
        GitHub ↗
      </a>
    </div>
  </div>
</nav>
