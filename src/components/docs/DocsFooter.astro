---
import StarlightFooter from '@astrojs/starlight/components/Footer.astro'
import CookieBanner from '../CookieBanner.astro'
---

<StarlightFooter {...Astro.props} />
<div class="veritio-docs-cookie-settings">
  <button type="button" data-cookie-settings onclick="window.VeritioConsent?.settings(this)">Cookie settings</button>
  <span>Veritio provides evidence support, not legal advice or automatic compliance.</span>
</div>
<CookieBanner />

<style>
  .veritio-docs-cookie-settings {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    border-top: 1px solid var(--sl-color-hairline);
    margin-top: 2rem;
    padding: 1rem 0;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
  }
  .veritio-docs-cookie-settings button { border: 0; background: transparent; color: inherit; padding: 0; font: inherit; text-decoration: underline; }
</style>
