---
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro'
import Search from '@astrojs/starlight/components/Search.astro'
import DocsThemeToggle from './DocsThemeToggle.astro'
---

<div class="veritio-docs-header">
  <a class="veritio-docs-brand" href="/" aria-label="Veritio home">
    <img src="/favicon.svg" alt="" width="30" height="30" />
    <span>Veritio</span>
    <span class="veritio-docs-label">Docs</span>
  </a>

  <div class="veritio-docs-search"><Search /></div>

  <nav class="veritio-docs-actions" aria-label="Documentation links">
    <a href="https://github.com/getveritio/veritio" target="_blank" rel="noopener noreferrer">GitHub</a>
    <DocsThemeToggle />
    <LanguageSelect />
    <a class="veritio-docs-cloud" href="https://console.getveritio.com/register" target="_blank" rel="noopener noreferrer">Start with Cloud ↗</a>
  </nav>

  <div class="veritio-docs-mobile"><DocsThemeToggle /></div>
</div>

<style>
  @layer starlight.core {
    .veritio-docs-header {
      display: grid;
      grid-template-columns: 18.5rem minmax(20rem, 1fr) auto;
      align-items: center;
      gap: 1.5rem;
      width: 100%;
      height: 100%;
    }

    .veritio-docs-brand {
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      width: fit-content;
      color: var(--sl-color-white);
      font-family: var(--sl-font);
      font-size: 1.2rem;
      font-weight: 650;
      text-decoration: none;
    }

    .veritio-docs-brand img { width: 1.85rem; height: 1.85rem; }
    .veritio-docs-search :global(button[data-open-modal]) { width: 100%; max-width: none; }
    .veritio-docs-label {
      border-inline-start: 1px solid var(--sl-color-gray-5);
      padding-inline-start: 0.7rem;
      color: var(--sl-color-gray-2);
      font-family: var(--sl-font-mono);
      font-size: 0.68rem;
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .veritio-docs-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 1rem;
      font-family: var(--sl-font);
      font-size: 0.78rem;
      font-weight: 500;
    }

    .veritio-docs-actions > a { color: var(--sl-color-gray-2); text-decoration: none; }
    .veritio-docs-actions > a:hover { color: var(--sl-color-white); }
    .veritio-docs-actions .veritio-docs-cloud {
      border: 1px solid var(--sl-color-accent);
      background: var(--sl-color-accent);
      color: var(--sl-color-black);
      padding: 0.68rem 0.9rem;
      letter-spacing: 0.02em;
    }

    .veritio-docs-mobile { display: none; align-items: center; justify-content: flex-end; gap: 0.4rem; }

    @media (max-width: 72rem) {
      .veritio-docs-header { grid-template-columns: minmax(12rem, auto) minmax(14rem, 1fr) auto; }
      .veritio-docs-actions > a:not(.veritio-docs-cloud) { display: none; }
    }

    @media (max-width: 50rem) {
      .veritio-docs-header { grid-template-columns: minmax(0, auto) minmax(9rem, 1fr) auto; gap: 0.75rem; }
      .veritio-docs-actions { display: none; }
      .veritio-docs-mobile { display: flex; }
      .veritio-docs-label { display: none; }
      .veritio-docs-search { min-width: 0; }
    }

    @media (max-width: 30rem) {
      .veritio-docs-brand span { display: none; }
      .veritio-docs-header { grid-template-columns: auto minmax(8rem, 1fr) auto; gap: 0.5rem; }
    }
  }
</style>
