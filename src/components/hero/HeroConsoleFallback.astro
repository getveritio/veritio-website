---
/**
 * Static, build-time snapshot of the Evidence Console strip-chart recorder at
 * its fully escalated end state. Rendered on the server so no-JS visitors and
 * the pre-hydration paint always see a complete, truthful panel (the Remotion
 * island is `client:only` and paints over this in the same slot — zero CLS).
 *
 * Consumes the same `data/episode.ts` module and choreography constants as
 * the animation, and reproduces the trace's cubic-out easing in plain math,
 * so every score, threshold, and curve point here matches what the Player
 * draws; numbers can never diverge between the two surfaces.
 */
import {
  EPISODE_ID,
  POLICY_VERSION,
  bandThresholds,
  finalRollup,
  timeline,
} from './data/episode'
import { consoleTheme as T, levelColor } from './theme'
import { ENTER_FRAMES, TRACE_DELAY, TRACE_IN, VERIFIED_AT } from './choreography'

const clockOf = (iso: string) => iso.slice(11, 19)

/** Mirrors StripChart.tsx `traceValueAt` (interpolate + Easing.out(Easing.cubic)). */
const cubicOut = (t: number) => 1 - (1 - t) ** 3
const traceValueAt = (frame: number) => {
  let value = 0
  for (let i = 0; i < timeline.length; i++) {
    const start = ENTER_FRAMES[i]! + TRACE_DELAY
    const prev = i === 0 ? 0 : timeline[i - 1]!.rollup.score
    const next = timeline[i]!.rollup.score
    if (frame < start) break
    const t = Math.min(1, Math.max(0, (frame - start) / TRACE_IN))
    value = prev + (next - prev) * cubicOut(t)
  }
  return value
}

/** Chart geometry — mirrors StripChart.tsx. */
const CHART_W = 1120 - 60
const CHART_H = 232
const padLeft = 52
const padRight = 96
const padY = 10
const plotW = CHART_W - padLeft - padRight
const plotH = CHART_H - padY * 2
const xOf = (f: number) => padLeft + plotW * Math.min(1, Math.max(0, f / VERIFIED_AT))
const yOf = (v: number) => padY + plotH * (1 - v)

const tracePoints: string[] = []
for (let f = 0; f <= VERIFIED_AT; f += 2) tracePoints.push(`${xOf(f)},${yOf(traceValueAt(f))}`)

const zones = [
  { at: bandThresholds.critical, mid: (bandThresholds.critical + 1) / 2, level: 'critical' as const },
  { at: bandThresholds.high, mid: (bandThresholds.high + bandThresholds.critical) / 2, level: 'high' as const },
  { at: bandThresholds.medium, mid: (bandThresholds.medium + bandThresholds.high) / 2, level: 'medium' as const },
  { at: bandThresholds.low, mid: (bandThresholds.low + bandThresholds.medium) / 2, level: 'low' as const },
]
const axisTicks = [1, 0.75, 0.5, 0.25, 0]
const finalColor = levelColor[finalRollup.level]
const ledgerCols = '56px 104px 1fr 250px 130px 190px'
---

<!--
  The panel is laid out at the composition's fixed 1120×640 canvas and scaled
  to the container by the SVG viewBox (same behavior as the Remotion Player's
  scale transform), so the fallback stays pixel-consistent at any hero size.
-->
<svg
  viewBox="0 0 1120 640"
  width="100%"
  height="100%"
  preserveAspectRatio="xMidYMid meet"
  role="img"
  aria-label="Veritio evidence console: a ledger of four hash-linked audit events whose risk rolls up to a critical activity episode on a strip chart"
>
<foreignObject x="0" y="0" width="1120" height="640">
<div
  style={`background:${T.bg};font-family:${T.mono};padding:24px 30px 20px;display:flex;flex-direction:column;width:1120px;height:640px;box-sizing:border-box;`}
>
  <div
    style={`display:flex;align-items:baseline;justify-content:space-between;padding-bottom:14px;border-bottom:1px solid ${T.lineStrong};`}
  >
    <span style={`font-size:13px;letter-spacing:3px;color:${T.text};`}>VERITIO · EVIDENCE STREAM</span>
    <span style={`font-size:11px;letter-spacing:1px;color:${T.textFaint};`}>
      tenant acme · production · policy {POLICY_VERSION}
    </span>
  </div>

  <div
    style={`display:grid;grid-template-columns:${ledgerCols};gap:18px;padding:10px 4px 8px;border-bottom:1px solid ${T.lineStrong};font-size:10.5px;letter-spacing:2.2px;color:${T.textFaint};`}
  >
    <span>SEQ</span><span>TIME</span><span>ACTION</span><span>ORIGIN</span>
    <span style="text-align:right;">RISK</span>
    <span style="text-align:right;">HASH</span>
  </div>

  {
    timeline.map((step) => (
      <div
        style={`display:grid;grid-template-columns:${ledgerCols};gap:18px;align-items:baseline;padding:16px 4px;border-bottom:1px solid ${T.line};font-size:14px;`}
      >
        <span style={`color:${T.textFaint};`}>#{step.sequence}</span>
        <span style={`color:${T.textSoft};`}>{clockOf(step.occurredAt)}</span>
        <span style={`color:${T.text};letter-spacing:0.2px;`}>{step.action}</span>
        <span style={`color:${T.textSoft};`}>{step.actor.type}·{step.actor.id}</span>
        <span style={`color:${levelColor[step.assessment.level]};text-align:right;`}>
          {step.assessment.score.toFixed(3)}
        </span>
        <span style={`color:${T.textFaint};text-align:right;`}>
          {step.prevHash.replace('…', '')} <span style={`color:${T.accentBright};`}>→</span> {step.hash.replace('…', '')}
        </span>
      </div>
    ))
  }

  <div
    style={`display:flex;align-items:baseline;justify-content:space-between;padding:16px 4px 14px;font-size:12px;letter-spacing:1.2px;`}
  >
    <span style={`color:${T.textFaint};`}>EPISODE <span style={`color:${T.textSoft};`}>{EPISODE_ID}</span></span>
    <span style={`color:${T.textFaint};`}>
      ROLLUP <span style={`color:${finalColor};`}>{finalRollup.score.toFixed(2)} {finalRollup.level.toUpperCase()}</span>
      {' · peak '}{finalRollup.peak.toFixed(2)}{' · velocity '}{finalRollup.velocityScore.toFixed(2)}
    </span>
    <span style={`color:${T.accentBright};`}>CHAIN VERIFIED ✓</span>
  </div>

  <svg width={CHART_W} height={CHART_H} style="display:block;" aria-hidden="true">
    {zones.map((zone) => (
      <>
        <line
          x1={padLeft}
          y1={yOf(zone.at)}
          x2={padLeft + plotW}
          y2={yOf(zone.at)}
          stroke={levelColor[zone.level]}
          stroke-width="1"
          stroke-dasharray="1 5"
          opacity="0.5"
        />
        <text
          x={padLeft + plotW + 12}
          y={yOf(zone.mid) + 3.5}
          fill={levelColor[zone.level]}
          opacity="0.75"
          font-family={T.mono}
          font-size="10.5"
          letter-spacing="1.5"
        >
          {zone.level.toUpperCase()}
        </text>
      </>
    ))}
    {axisTicks.map((tick) => (
      <text
        x={padLeft - 12}
        y={yOf(tick) + 3.5}
        text-anchor="end"
        fill={T.textFaint}
        font-family={T.mono}
        font-size="10.5"
      >
        {tick.toFixed(2)}
      </text>
    ))}
    <line x1={padLeft} y1={padY} x2={padLeft} y2={padY + plotH} stroke={T.lineStrong} stroke-width="1" />
    <line x1={padLeft} y1={padY + plotH} x2={padLeft + plotW} y2={padY + plotH} stroke={T.lineStrong} stroke-width="1" />
    {timeline.map((step, i) => (
      <line
        x1={xOf(ENTER_FRAMES[i]! + TRACE_DELAY)}
        y1={padY + plotH}
        x2={xOf(ENTER_FRAMES[i]! + TRACE_DELAY)}
        y2={padY + plotH + 5}
        stroke={levelColor[step.rollup.level]}
        stroke-width="1.5"
      />
    ))}
    <polyline points={tracePoints.join(' ')} fill="none" stroke={T.accentBright} stroke-width="1.8" />
    <circle cx={xOf(VERIFIED_AT)} cy={yOf(finalRollup.score)} r="3.2" fill={finalColor} />
  </svg>
</div>
</foreignObject>
</svg>
