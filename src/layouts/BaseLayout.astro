---
import '../styles/global.css'

/**
 * Site-wide head/SEO boundary: every page renders through this layout, so
 * canonical URLs, Open Graph/Twitter cards, and the sitewide Organization +
 * WebSite JSON-LD live here exactly once. Pages may pass `jsonLd` (array of
 * schema.org objects) for page-specific structured data — pricing offers,
 * docs breadcrumbs — which renders alongside, never instead of, the sitewide
 * graph. og.png (raster, 1200×630) is deliberate: most social crawlers do not
 * render SVG og:images, so keep og.png in sync with og.svg when the design
 * changes. Keep marketing copy here evidence-support-shaped: Veritio supports
 * compliance evidence; it does not make anyone compliant.
 */
const {
  title = 'Veritio',
  description = 'Protocol-first evidence support for audit trails, change provenance, and governance workflows.',
  jsonLd = [],
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site).href
const ogImage = new URL('/og.png', Astro.site).href
const ogImageAlt = 'Veritio — evidence graph for audit trails and governance'

const siteJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://getveritio.com/#organization',
    name: 'Veritio',
    url: 'https://getveritio.com/',
    logo: new URL('/favicon.svg', Astro.site).href,
    email: 'hello@getveritio.com',
    sameAs: ['https://github.com/getveritio'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://getveritio.com/#website',
    name: 'Veritio',
    url: 'https://getveritio.com/',
    publisher: { '@id': 'https://getveritio.com/#organization' },
  },
  ...jsonLd,
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f8faf7" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Veritio" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
