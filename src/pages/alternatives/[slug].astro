---
/**
 * Comparison pages (/alternatives/<slug>), generated from
 * src/data/alternatives.ts. Honest, approach-level comparisons: concede the
 * other tool's strengths, date the review, no compliance claims.
 *
 * Layout (Aug 2026 rework, per approved design concept): two-column hero with
 * a live "VS" evidence card (competitor's native view vs Veritio's
 * hash-linked chain — built from page data, not an image), check-marked
 * strengths/differences cards with filled icon chips, a side-by-side table
 * with a dark Veritio column + check discs, choose-when cards, and a dark
 * closing band. Rounded corners + soft evergreen-tinted shadows are
 * intentional on these pages; the pre-rendered PNGs remain in use as OG
 * cards and /alternatives index thumbnails.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import Section from '../../components/Section.astro'
import { alternatives, lastReviewed } from '../../data/alternatives'

export function getStaticPaths() {
  return alternatives.map((alt) => ({ params: { slug: alt.slug }, props: { alt } }))
}

const { alt } = Astro.props
const ossRepo = 'https://github.com/getveritio/veritio'
// Per-page social card, generated by scripts/generate-alt-images.mjs into
// public/og/ (raw-served so the URL stays stable for social crawlers). Every
// alternatives slug MUST have a matching card there — run `bun run images:alt`
// after adding an entry, or this meta points at a 404.
const ogImage = `/og/${alt.slug}.png`
const ogImageAlt = `Veritio vs ${alt.name} — open-source evidence layer comparison card`

// Two-line hero lockup: text before the first colon in ink, the qualifier
// after it on its own accent line (matches the approved concept).
const colonIdx = alt.heading.indexOf(':')
const headingMain = colonIdx > -1 ? alt.heading.slice(0, colonIdx + 1) : alt.heading
const headingRest = colonIdx > -1 ? alt.heading.slice(colonIdx + 1).trim() : ''

// Soft evergreen-tinted elevation shared by the cards on this page.
const cardShadow = 'shadow-[0_1px_2px_rgba(16,35,27,0.05),0_16px_40px_-16px_rgba(16,35,27,0.14)]'
---

<BaseLayout title={alt.metaTitle} description={alt.metaDescription} ogImage={ogImage} ogImageAlt={ogImageAlt}>
  <Nav />

  <main id="main-content">
    <!-- Hero: thesis left, live VS evidence card right -->
    <section class="relative overflow-hidden">
      <!-- decorative dot texture, per concept -->
      <div
        class="pointer-events-none absolute -left-10 top-32 hidden h-72 w-56 opacity-40 lg:block"
        style="background-image: radial-gradient(var(--color-line-strong) 1px, transparent 1px); background-size: 13px 13px; mask-image: radial-gradient(closest-side, black, transparent);"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute -right-10 bottom-4 hidden h-72 w-56 opacity-40 lg:block"
        style="background-image: radial-gradient(var(--color-line-strong) 1px, transparent 1px); background-size: 13px 13px; mask-image: radial-gradient(closest-side, black, transparent);"
        aria-hidden="true"
      ></div>

      <div class="container relative">
        <div class="border-b border-line py-3 font-mono text-[11px] uppercase tracking-[0.16em] text-ink-muted">
          <a href="/alternatives/" class="text-ink-muted no-underline hover:text-accent">Alternatives</a>
          &nbsp;/&nbsp;{alt.name}
        </div>

        <div class="grid items-center gap-12 py-12 lg:grid-cols-[1fr_minmax(500px,560px)] lg:gap-14 lg:py-16">
          <div>
            <h1 class="font-medium" style="font-size: clamp(30px, 3.2vw, 44px); line-height: 1.12; letter-spacing: -0.01em;">
              <span class="block text-ink">{headingMain}</span>
              {headingRest && <span class="block text-accent-strong">{headingRest}</span>}
            </h1>
            <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">{alt.what}</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="/cloud/" class="doc-btn doc-btn--solid rounded-md">See Veritio Cloud</a>
              <a href={ossRepo} target="_blank" rel="noopener noreferrer" class="doc-btn rounded-md">View on GitHub ↗</a>
            </div>
            <p class="mt-7 flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.13em] text-ink-muted">
              <svg class="shrink-0 text-accent-soft" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5 19 6v5.2c0 4.3-2.9 7.2-7 8.8-4.1-1.6-7-4.5-7-8.8V6l7-2.5z"/></svg>
              <span>Apache-2.0 core&ensp;·&ensp;Verifies offline&ensp;·&ensp;Self-host or cloud</span>
            </p>
          </div>

          <!-- VS card: competitor's native view vs Veritio's evidence chain -->
          <aside aria-label={`${alt.name} compared with Veritio at a glance`} class:list={['relative rounded-xl border border-line bg-surface-raised', cardShadow]}>
            <div class="grid sm:grid-cols-2">
              <div class="border-b border-line p-5 sm:border-b-0 sm:border-r">
                <p class="font-mono text-[12px] font-semibold uppercase tracking-[0.18em] text-ink">{alt.name}</p>
                <p class="mt-1 font-mono text-[11px] text-ink-muted">{alt.panel.themSub}</p>
                <div class="mt-5 rounded-lg border border-line bg-surface p-3.5">
                  <p class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-ink-muted">{alt.panel.themTitle}</p>
                  <ul class="relative mt-3.5 flex flex-col gap-3 pl-4">
                    <span class="absolute bottom-1 left-[3px] top-1 w-px border-l border-dashed border-line-strong" aria-hidden="true"></span>
                    {alt.panel.themRows.map((row) => (
                      <li class="flex items-baseline gap-2">
                        <span class:list={['min-w-0 break-words font-mono text-[11px]', row.tone === 'seal' ? 'text-seal' : 'text-ink-soft']}>{row.name}</span>
                        {row.detail && (
                          <span class:list={['ml-auto shrink-0 text-right font-mono text-[9.5px]', row.tone === 'seal' ? 'text-seal' : 'text-ink-muted']}>{row.detail}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
                <p class="mt-4 font-mono text-[10.5px] leading-relaxed text-ink-muted">{alt.panel.themFoot}</p>
              </div>

              <div class="p-5">
                <p class="font-mono text-[12px] font-semibold uppercase tracking-[0.18em] text-accent-strong">Veritio</p>
                <p class="mt-1 font-mono text-[11px] text-ink-muted">Evidence &amp; verification</p>
                <div class="mt-5 rounded-lg border border-line bg-surface p-3.5">
                  <p class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-ink-muted">Evidence chain</p>
                  <ul class="mt-3.5 flex flex-col">
                    {alt.panel.chain.map((ev, i) => (
                      <li class="relative flex items-baseline gap-2 pb-3 pl-4 last:pb-0">
                        {i < alt.panel.chain.length - 1 && (
                          <span class="absolute left-[3px] top-2 h-full w-px bg-accent/40" aria-hidden="true"></span>
                        )}
                        <span class="absolute left-0 top-[4px] h-[7px] w-[7px] rounded-full bg-accent" aria-hidden="true"></span>
                        <span class="min-w-0 break-words font-mono text-[11px] text-ink-soft">{ev.action}</span>
                        {ev.risk && <span class="ml-auto shrink-0 font-mono text-[9.5px] text-accent-strong">risk {ev.risk}</span>}
                      </li>
                    ))}
                  </ul>
                  <div class="mt-4 flex items-center gap-3 border-t border-line pt-3.5">
                    <span class="whitespace-nowrap rounded-md border border-accent-strong px-2.5 py-1 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-accent-strong">Verify: valid</span>
                    <span class="font-mono text-[10px] text-ink-muted">offline</span>
                  </div>
                </div>
                <p class="mt-4 font-mono text-[10.5px] leading-relaxed text-ink-muted">{alt.panel.usFoot}</p>
              </div>
            </div>

            <!-- VS badge on the divider, header-level per concept -->
            <span
              class:list={['absolute left-1/2 top-9 hidden h-10 w-10 -translate-x-1/2 items-center justify-center rounded-full border border-line-strong bg-surface-raised font-mono text-[10.5px] font-semibold uppercase tracking-[0.08em] text-ink-soft sm:flex', cardShadow]}
              aria-hidden="true"
            >vs</span>
          </aside>
        </div>
      </div>
    </section>

    <!-- Strengths / differences cards -->
    <Section tone="sunken">
      <div class="grid gap-6 lg:grid-cols-2">
        <div class:list={['rounded-xl border border-line bg-surface-raised p-8', cardShadow]}>
          <div class="flex items-center gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-evergreen text-surface" aria-hidden="true">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18 9.5 12l3.5 3.5L20 8"/><path d="M15.5 8H20v4.5"/></svg>
            </span>
            <h2 class="text-xl font-semibold text-ink">What {alt.name} does well</h2>
          </div>
          <ul class="mt-6 flex flex-col gap-4">
            {alt.strengths.map((s) => (
              <li class="flex gap-3 text-base leading-relaxed text-ink-soft">
                <svg class="mt-1 shrink-0 text-accent-soft" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/></svg>
                <span>{s}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class:list={['rounded-xl border border-line bg-surface-raised p-8', cardShadow]}>
          <div class="flex items-center gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-evergreen text-surface" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5 19 6v5.2c0 4.3-2.9 7.2-7 8.8-4.1-1.6-7-4.5-7-8.8V6l7-2.5z"/><path d="m9 12 2.2 2.2L15.5 10"/></svg>
            </span>
            <h2 class="text-xl font-semibold text-ink">Where Veritio differs</h2>
          </div>
          <ul class="mt-6 flex flex-col gap-4">
            {alt.differences.map((d) => (
              <li class="flex gap-3 text-base leading-relaxed text-ink-soft">
                <svg class="mt-1 shrink-0 text-accent" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/></svg>
                <span>{d}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Section>

    <!-- Side-by-side comparison, Veritio column highlighted -->
    <Section>
      <h2 class="text-2xl font-semibold text-ink">Side-by-side comparison</h2>
      <div class:list={['mt-6 overflow-x-auto rounded-xl border border-line bg-surface-raised', cardShadow]}>
        <table class="w-full min-w-[640px] border-collapse text-left">
          <thead>
            <tr>
              <th class="border-b border-line py-3.5 pl-6 pr-6 font-mono text-[11px] font-medium uppercase tracking-[0.12em] text-ink-muted">Capability</th>
              <th class="border-b border-line py-3.5 pr-6 font-mono text-[11px] font-medium uppercase tracking-[0.12em] text-ink-muted">{alt.name}</th>
              <th class="border-b border-evergreen bg-evergreen px-5 py-3.5 font-mono text-[11px] font-medium uppercase tracking-[0.12em] text-surface" colspan="2">Veritio</th>
            </tr>
          </thead>
          <tbody>
            {alt.table.map((row, i) => (
              <tr class:list={[i < alt.table.length - 1 && 'border-b border-line']}>
                <td class="py-4 pl-6 pr-6 align-top text-sm font-medium text-ink">{row.dimension}</td>
                <td class="py-4 pr-6 align-top text-sm leading-relaxed text-ink-soft">{row.them}</td>
                <td class="bg-accent/5 py-4 pl-5 align-top text-sm leading-relaxed text-ink">{row.veritio}</td>
                <td class="w-12 bg-accent/5 py-4 pr-5 text-right align-top">
                  <span class="inline-flex h-[18px] w-[18px] items-center justify-center rounded-full bg-accent" aria-hidden="true">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#f6f3ea" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m6.5 12.5 3.5 3.5 7-8"/></svg>
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-5 flex max-w-3xl gap-2 font-mono text-[11.5px] leading-relaxed text-ink-muted">
        <svg class="mt-0.5 shrink-0 text-accent-soft" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5 19 6v5.2c0 4.3-2.9 7.2-7 8.8-4.1-1.6-7-4.5-7-8.8V6l7-2.5z"/></svg>
        <span>
          Comparison last reviewed {lastReviewed}. Products change — check vendor
          documentation for current behavior. Veritio provides evidence support
          for reviews and investigations, not automatic compliance.
        </span>
      </p>
    </Section>

    <!-- Choose-when cards -->
    <Section tone="sunken">
      <div class="grid gap-6 lg:grid-cols-2">
        <div class:list={['rounded-xl border border-line bg-surface-raised p-8', cardShadow]}>
          <div class="flex items-center gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-evergreen text-surface" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 6a4 4 0 0 0-5.4 5L4 16.2 7.8 20l5.2-5.1a4 4 0 0 0 5-5.4l-2.6 2.6-2.4-2.4L14.5 6z"/></svg>
            </span>
            <h2 class="text-xl font-semibold text-ink">Choose {alt.name} when…</h2>
          </div>
          <p class="mt-5 text-base leading-relaxed text-ink-soft">{alt.chooseThem}</p>
        </div>
        <div class:list={['rounded-xl border border-accent-soft/60 bg-surface-raised p-8', cardShadow]}>
          <div class="flex items-center gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-evergreen text-surface" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5 19 6v5.2c0 4.3-2.9 7.2-7 8.8-4.1-1.6-7-4.5-7-8.8V6l7-2.5z"/><path d="m9 12 2.2 2.2L15.5 10"/></svg>
            </span>
            <h2 class="text-xl font-semibold text-ink">Choose Veritio when…</h2>
          </div>
          <p class="mt-5 text-base leading-relaxed text-ink-soft">{alt.chooseUs}</p>
        </div>
      </div>
    </Section>

    <!-- Dark closing band -->
    <section class="relative overflow-hidden bg-surface-invert">
      <div
        class="pointer-events-none absolute -right-8 top-1/2 hidden h-64 w-72 -translate-y-1/2 opacity-25 lg:block"
        style="background-image: radial-gradient(rgba(246,243,234,0.7) 1px, transparent 1px); background-size: 13px 13px; mask-image: radial-gradient(closest-side, black, transparent);"
        aria-hidden="true"
      ></div>
      <div class="container relative flex flex-col gap-8 py-14 lg:flex-row lg:items-center lg:justify-between lg:py-16">
        <div class="max-w-xl">
          <h2 class="font-medium text-surface" style="font-size: 30px; letter-spacing: -0.01em;">Stronger together</h2>
          <p class="mt-3 text-base leading-relaxed text-surface/70">{alt.closing}</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/cloud/" class="doc-btn doc-btn--invert-solid rounded-md">See Veritio Cloud</a>
          <a href={ossRepo} target="_blank" rel="noopener noreferrer" class="doc-btn doc-btn--invert rounded-md">View on GitHub ↗</a>
          <a href="/alternatives/" class="doc-btn doc-btn--invert rounded-md">More comparisons</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
