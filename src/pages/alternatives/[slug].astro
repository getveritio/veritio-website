---
/**
 * Comparison pages (/alternatives/<slug>), generated from
 * src/data/alternatives.ts. Honest, approach-level comparisons: concede the
 * other tool's strengths, date the review, no compliance claims.
 *
 * Layout (Aug 2026 rework): two-column hero with a live "VS" evidence panel
 * (competitor's native view vs Veritio's hash-linked chain — built from the
 * page data, not an image), check-marked strengths/differences columns, a
 * side-by-side table with the Veritio column highlighted, choose-when cards,
 * and a dark closing band. The pre-rendered PNGs remain in use as OG cards
 * and as /alternatives index thumbnails.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import Section from '../../components/Section.astro'
import { alternatives, lastReviewed } from '../../data/alternatives'

export function getStaticPaths() {
  return alternatives.map((alt) => ({ params: { slug: alt.slug }, props: { alt } }))
}

const { alt } = Astro.props
const ossRepo = 'https://github.com/getveritio/veritio'
// Per-page social card, generated by scripts/generate-alt-images.mjs into
// public/og/ (raw-served so the URL stays stable for social crawlers). Every
// alternatives slug MUST have a matching card there — run `bun run images:alt`
// after adding an entry, or this meta points at a 404.
const ogImage = `/og/${alt.slug}.png`
const ogImageAlt = `Veritio vs ${alt.name} — open-source evidence layer comparison card`

// Split the heading on the first colon so the qualifier renders in accent
// serif (e.g. "Veritio vs Langfuse:" + "evidence layer vs LLM observability").
const colonIdx = alt.heading.indexOf(':')
const headingMain = colonIdx > -1 ? alt.heading.slice(0, colonIdx + 1) : alt.heading
const headingRest = colonIdx > -1 ? alt.heading.slice(colonIdx + 1).trim() : ''
---

<BaseLayout title={alt.metaTitle} description={alt.metaDescription} ogImage={ogImage} ogImageAlt={ogImageAlt}>
  <Nav />

  <main>
    <!-- Hero: thesis left, live VS evidence panel right -->
    <section>
      <div class="container">
        <div class="border-b border-line py-3 font-mono text-[11px] uppercase tracking-[0.16em] text-ink-muted">
          <a href="/alternatives" class="text-ink-muted no-underline hover:text-accent">Alternatives</a>
          &nbsp;/&nbsp;{alt.name}
        </div>

        <div class="grid items-start gap-12 py-12 lg:grid-cols-[1fr_minmax(380px,460px)] lg:gap-16 lg:py-16">
          <div>
            <h1
              class="max-w-[26ch] font-medium text-ink"
              style="font-size: clamp(30px, 3.2vw, 42px); line-height: 1.08; letter-spacing: -0.01em;"
            >
              {headingMain}
              {headingRest && <span class="text-accent-strong">{` ${headingRest}`}</span>}
            </h1>
            <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-soft">{alt.what}</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="/cloud" class="doc-btn doc-btn--solid">See Veritio Cloud</a>
              <a href={ossRepo} target="_blank" rel="noopener noreferrer" class="doc-btn">View on GitHub ↗</a>
            </div>
            <p class="mt-6 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-muted">
              Apache-2.0 core&ensp;·&ensp;Verifies offline&ensp;·&ensp;Self-host or cloud
            </p>
          </div>

          <!-- VS panel: competitor's native view vs Veritio's evidence chain -->
          <aside aria-label={`${alt.name} compared with Veritio at a glance`} class="relative border border-line bg-surface-raised">
            <div class="grid sm:grid-cols-2">
              <div class="border-b border-line p-5 sm:border-b-0 sm:border-r">
                <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-ink">{alt.name}</p>
                <p class="mt-0.5 font-mono text-[10.5px] text-ink-muted">{alt.panel.themSub}</p>
                <div class="mt-4 border border-line bg-surface p-3.5">
                  <p class="font-mono text-[10.5px] uppercase tracking-[0.12em] text-ink-muted">{alt.panel.themTitle}</p>
                  <ul class="mt-3 flex flex-col gap-2.5">
                    {alt.panel.themRows.map((row) => (
                      <li class="flex items-baseline justify-between gap-3">
                        <span class:list={['font-mono text-[11.5px]', row.tone === 'seal' ? 'text-seal' : 'text-ink-soft']}>{row.name}</span>
                        {row.detail && (
                          <span class:list={['text-right font-mono text-[10px]', row.tone === 'seal' ? 'text-seal' : 'text-ink-muted']}>{row.detail}</span>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
                <p class="mt-3 font-mono text-[10.5px] leading-relaxed text-ink-muted">{alt.panel.themFoot}</p>
              </div>

              <div class="p-5">
                <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-accent-strong">Veritio</p>
                <p class="mt-0.5 font-mono text-[10.5px] text-ink-muted">Evidence &amp; verification</p>
                <div class="mt-4 border border-line bg-surface p-3.5">
                  <p class="font-mono text-[10.5px] uppercase tracking-[0.12em] text-ink-muted">Evidence chain</p>
                  <ul class="mt-3 flex flex-col">
                    {alt.panel.chain.map((ev, i) => (
                      <li class="relative flex items-baseline justify-between gap-3 pb-2.5 pl-4 last:pb-0">
                        {i < alt.panel.chain.length - 1 && (
                          <span class="absolute left-[3px] top-2 h-full w-px bg-accent/50" aria-hidden="true"></span>
                        )}
                        <span class="absolute left-0 top-[5px] h-[7px] w-[7px] rounded-full bg-accent" aria-hidden="true"></span>
                        <span class="font-mono text-[11.5px] text-ink-soft">{ev.action}</span>
                        {ev.risk && <span class="whitespace-nowrap font-mono text-[10px] text-accent-strong">risk {ev.risk}</span>}
                      </li>
                    ))}
                  </ul>
                  <div class="mt-3.5 flex items-center gap-2.5 border-t border-line pt-3">
                    <span class="whitespace-nowrap border border-accent-strong px-2 py-1 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-accent-strong">Verify: valid</span>
                    <span class="font-mono text-[10px] text-ink-muted">offline</span>
                  </div>
                </div>
                <p class="mt-3 font-mono text-[10.5px] leading-relaxed text-ink-muted">{alt.panel.usFoot}</p>
              </div>
            </div>

            <!-- VS seal on the divider -->
            <span
              class="absolute left-1/2 top-1/2 hidden h-9 w-9 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-line-strong bg-surface font-mono text-[10px] font-semibold uppercase tracking-[0.08em] text-ink-soft sm:flex"
              aria-hidden="true"
            >vs</span>
          </aside>
        </div>
      </div>
    </section>

    <!-- Strengths / differences -->
    <Section tone="raised">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
        <div>
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-surface-sunken text-ink-soft" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>
            </span>
            <div>
              <span class="eyebrow">Credit where due</span>
              <h2 class="text-lg font-semibold text-ink">What {alt.name} does well</h2>
            </div>
          </div>
          <ul class="mt-6 flex flex-col gap-3.5">
            {alt.strengths.map((s) => (
              <li class="flex gap-3 text-base leading-relaxed text-ink-soft">
                <svg class="mt-1 shrink-0 text-line-strong" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/></svg>
                <span>{s}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-evergreen text-surface" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5 19 6v5.2c0 4.3-2.9 7.2-7 8.8-4.1-1.6-7-4.5-7-8.8V6l7-2.5z"/><path d="m9 12 2.2 2.2L15.5 10"/></svg>
            </span>
            <div>
              <span class="eyebrow">The Veritio approach</span>
              <h2 class="text-lg font-semibold text-ink">Where Veritio differs</h2>
            </div>
          </div>
          <ul class="mt-6 flex flex-col gap-3.5">
            {alt.differences.map((d) => (
              <li class="flex gap-3 text-base leading-relaxed text-ink-soft">
                <svg class="mt-1 shrink-0 text-accent" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/></svg>
                <span>{d}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Section>

    <!-- Side-by-side table, Veritio column highlighted -->
    <Section>
      <span class="eyebrow">Side by side</span>
      <h2 class="mt-3 text-lg font-semibold text-ink">At a glance</h2>
      <div class="mt-6 overflow-x-auto">
        <table class="w-full border-collapse text-left">
          <thead>
            <tr>
              <th class="border-b border-line-strong py-3 pr-6 font-mono text-[11px] font-medium uppercase tracking-[0.12em] text-ink-muted"></th>
              <th class="border-b border-line-strong py-3 pr-6 font-mono text-[11px] font-medium uppercase tracking-[0.12em] text-ink-muted">{alt.name}</th>
              <th class="border-b border-evergreen bg-evergreen px-4 py-3 font-mono text-[11px] font-medium uppercase tracking-[0.12em] text-surface">Veritio</th>
            </tr>
          </thead>
          <tbody>
            {alt.table.map((row) => (
              <tr class="border-b border-line">
                <td class="py-3.5 pr-6 align-top text-sm font-medium text-ink">{row.dimension}</td>
                <td class="py-3.5 pr-6 align-top text-sm leading-relaxed text-ink-soft">{row.them}</td>
                <td class="bg-surface-raised px-4 py-3.5 align-top text-sm leading-relaxed text-ink">
                  <span class="flex items-start justify-between gap-3">
                    <span>{row.veritio}</span>
                    <svg class="mt-0.5 shrink-0 text-accent" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.5 2.5 4.5-5"/></svg>
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 font-mono text-[11.5px] leading-relaxed text-ink-muted">
        Comparison last reviewed {lastReviewed}. Products change — check vendor
        documentation for current behavior. Veritio provides evidence support
        for reviews and investigations, not automatic compliance.
      </p>
    </Section>

    <!-- Choose-when cards -->
    <Section tone="sunken">
      <div class="grid gap-6 lg:grid-cols-2">
        <div class="border border-line bg-surface p-7">
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-surface-sunken text-ink-soft" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 6a4 4 0 0 0-5.4 5L4 16.2 7.8 20l5.2-5.1a4 4 0 0 0 5-5.4l-2.6 2.6-2.4-2.4L14.5 6z"/></svg>
            </span>
            <h2 class="text-lg font-semibold text-ink">Choose {alt.name} when…</h2>
          </div>
          <p class="mt-4 text-base leading-relaxed text-ink-soft">{alt.chooseThem}</p>
        </div>
        <div class="border border-accent-soft bg-surface p-7">
          <div class="flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-evergreen text-surface" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.5 19 6v5.2c0 4.3-2.9 7.2-7 8.8-4.1-1.6-7-4.5-7-8.8V6l7-2.5z"/><path d="m9 12 2.2 2.2L15.5 10"/></svg>
            </span>
            <h2 class="text-lg font-semibold text-ink">Choose Veritio when…</h2>
          </div>
          <p class="mt-4 text-base leading-relaxed text-ink-soft">{alt.chooseUs}</p>
        </div>
      </div>
    </Section>

    <!-- Dark closing band -->
    <section class="bg-surface-invert">
      <div class="container flex flex-col gap-8 py-14 lg:flex-row lg:items-center lg:justify-between lg:py-16">
        <div class="max-w-xl">
          <h2 class="font-medium text-surface" style="font-size: 28px; letter-spacing: -0.01em;">Stronger together</h2>
          <p class="mt-3 text-base leading-relaxed text-surface/70">{alt.closing}</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/cloud" class="doc-btn doc-btn--invert-solid">See Veritio Cloud</a>
          <a href={ossRepo} target="_blank" rel="noopener noreferrer" class="doc-btn doc-btn--invert">View on GitHub ↗</a>
          <a href="/alternatives" class="doc-btn doc-btn--invert">More comparisons</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
