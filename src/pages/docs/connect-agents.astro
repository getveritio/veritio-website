---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import Section from '../../components/Section.astro'
import CodeBlock from '../../components/CodeBlock.astro'
import FeatureCard from '../../components/FeatureCard.astro'

const claudeInstall = `/plugin marketplace add getveritio/veritio
/plugin install veritio@veritio`

const checkoutSetup = `git clone https://github.com/getveritio/veritio.git
cd veritio
bun install --frozen-lockfile
bun run --cwd cli build`

const claudeLogin = `bun cli/dist/index.js login claude`

const codexLogin = `bun cli/dist/index.js login codex`

const pluginReadme =
  'https://github.com/getveritio/veritio/tree/main/plugins/veritio'

const recorded = [
  {
    title: 'Session lifecycle',
    body: 'Claude records session start/end; local Codex notify records a bounded turn-level session marker.',
  },
  {
    title: 'Prompts',
    body: 'The prompt is recorded as a content hash — never the raw text.',
  },
  {
    title: 'Tool calls & file changes',
    body: 'Claude hooks capture edits and tools as hashes. Codex notify does not expose these details.',
  },
  {
    title: 'Query it back',
    body: 'Claude local evidence is queryable through its local MCP. Codex evidence needs optional hosted delivery before the hosted MCP can query it.',
  },
]

/** Breadcrumb structured data; positions mirror the visible nav hierarchy. */
const breadcrumbJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://getveritio.com/' },
      { '@type': 'ListItem', position: 2, name: 'Documentation', item: 'https://getveritio.com/docs/' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Connect Claude Code & Codex',
        item: 'https://getveritio.com/docs/connect-agents/',
      },
    ],
  },
]
---

<BaseLayout
  title="Connect Claude Code & Codex — Veritio"
  description="Connect local Claude Code and Codex CLI sessions to a bounded, local-first Veritio evidence trail. Hosted delivery is optional and never auto-drains a backlog."
  jsonLd={breadcrumbJsonLd}
>
  <Nav />

  <section class="py-16 sm:py-20">
    <div class="container">
      <span class="eyebrow">Connect your agents</span>
      <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-muted">
        Updated <time datetime="2026-08-03">3 August 2026</time>
      </p>
      <h1
        class="mt-4 max-w-3xl font-semibold tracking-tight text-ink"
        style="font-size: var(--text-headline); line-height: var(--text-headline--line-height);"
      >
        Connect Claude Code & local Codex safely
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">
        Record what local coding agents actually did — session by session, as a
        hash-chained evidence trail. Claude can query its local store over MCP;
        local Codex needs optional hosted delivery before hosted MCP queries.
        Capture is local-first; hosted delivery is optional and bounded.
      </p>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-muted">
        This page covers offline capture and the optional hosted-connected path.
        The open-source SDK and local Workbench run fully offline without an
        account — see{' '}
        <a class="text-accent no-underline hover:text-accent-strong" href="/examples">Examples</a>.
      </p>
    </div>
  </section>

  <Section id="availability" tone="sunken">
    <h2 class="text-2xl font-semibold tracking-tight text-ink">Current availability</h2>
    <p class="mt-3 max-w-2xl text-ink-soft">
      <code class="inline">@veritio/claude-code</code> is published. The
      <code class="inline">veritio</code> CLI and
      <code class="inline">@veritio/codex</code> adapter are still
      <strong class="text-ink"> repository-checkout previews</strong>. Keep the
      checkout in place after Codex setup because its notify wrapper points to
      the reviewed local adapter build.
    </p>
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-muted">
      The marketplace hooks are pinned to <code class="inline">@veritio/claude-code@0.4.6</code>.
      Publish and verify that exact registry version before releasing this plugin update; the pin
      intentionally fails closed if the package is unavailable and never falls back to 0.4.5.
    </p>
    <div class="mt-8 max-w-2xl">
      <CodeBlock code={checkoutSetup} lang="bash" title="repository checkout" />
    </div>
  </Section>

  <Section id="claude-code">
    <h2 class="text-2xl font-semibold tracking-tight text-ink">Claude Code</h2>
    <p class="mt-3 max-w-2xl text-ink-soft">
      Install the Veritio plugin from the marketplace. It bundles the capture
      hooks and registers the hosted MCP server.
    </p>
    <div class="mt-8 max-w-2xl">
      <CodeBlock code={claudeInstall} lang="bash" title="Claude Code" />
    </div>
    <p class="mt-5 max-w-2xl text-sm leading-relaxed text-ink-soft">
      The plugin ships <strong class="text-ink">disabled by default</strong>.
      Enable it with <code class="inline">/plugin</code> for local capture. To
      opt into hosted delivery from the repository checkout, run:
    </p>
    <div class="mt-6 max-w-2xl">
      <CodeBlock code={claudeLogin} lang="bash" title="terminal" />
    </div>
    <p class="mt-5 max-w-2xl text-sm leading-relaxed text-ink-soft">
      The command opens your browser, mints a scoped, revocable key after
      approval, and prints the exact environment block to add to Claude settings
      — no key is pasted into the command line. The plugin pins a reviewed
      package version instead of resolving npm latest on every hook. For the
      read side, approve the hosted MCP once in <code class="inline">/mcp</code>.
    </p>
  </Section>

  <Section id="codex" tone="sunken">
    <h2 class="text-2xl font-semibold tracking-tight text-ink">Codex CLI</h2>
    <p class="mt-3 max-w-2xl text-ink-soft">
      Codex CLI has one notify slot. The checkout command writes a wrapper that
      preserves any existing notifier and invokes the absolute reviewed adapter
      build; it does not depend on an unpublished global binary.
    </p>
    <div class="mt-8 max-w-2xl">
      <CodeBlock code={codexLogin} lang="bash" title="terminal" />
    </div>
    <p class="mt-5 max-w-2xl text-sm leading-relaxed text-ink-soft">
      The adapter writes locally first. If hosted credentials are approved, one
      turn makes at most one remote POST with a 10-second default and 30-second
      maximum timeout. It has no automatic retry or backlog drain. Your existing
      <code class="inline">notify</code> command keeps running.
    </p>
  </Section>

  <Section id="economic-safety">
    <h2 class="text-2xl font-semibold tracking-tight text-ink">
      Local, GitHub, and spend boundaries
    </h2>
    <p class="mt-3 max-w-2xl text-ink-soft">
      Claude's model/API charges, Codex usage, GitHub Actions minutes, and
      Veritio delivery are separate budgets. Veritio limits only its own
      delivery: Claude queues are finite and never auto-drain; Codex sends one
      bounded request per local CLI turn. Production stress and spool drains do
      not belong in pull-request workflows.
    </p>
    <p class="mt-5 max-w-2xl text-sm leading-relaxed text-ink-soft">
      For Claude Code GitHub Actions, use a narrow trigger, workflow concurrency,
      <code class="inline">timeout-minutes</code>, and
      <code class="inline">--max-turns</code>. Install an exact reviewed capture
      version and keep credentials in GitHub Secrets. The local Codex notify
      adapter does <strong class="text-ink">not</strong> claim capture of Codex
      cloud tasks or GitHub code reviews because those products do not expose
      the local CLI notify callback to this adapter.
    </p>
  </Section>

  <Section id="recorded">
    <h2 class="text-2xl font-semibold tracking-tight text-ink">
      What gets recorded
    </h2>
    <p class="mt-3 max-w-2xl text-ink-soft">
      Raw prompts, tool argument payloads, and file contents are not stored.
      Stable ids and content hashes form the evidence trail. Claude may retain
      raw file paths temporarily in local session state to pair pre/post edit
      hashes; those paths are not sent as evidence metadata.
    </p>
    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {
        recorded.map((item) => (
          <FeatureCard title={item.title}>{item.body}</FeatureCard>
        ))
      }
    </div>
    <p class="mt-8 max-w-2xl text-sm leading-relaxed text-ink-muted">
      Veritio produces compliance <em>evidence</em>; it does not make you
      compliant and is not legal advice.
    </p>
  </Section>

  <Section id="cta" tone="sunken">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-semibold tracking-tight text-ink">
        Read the details
      </h2>
      <p class="mt-3 text-ink-soft">
        The plugin README covers the full event mapping, delivery circuit,
        GitHub-hosted boundaries, environment contract, and requirements.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a
          class="doc-btn doc-btn--solid"
          href={pluginReadme}
          target="_blank"
          rel="noopener noreferrer"
        >
          Plugin README →
        </a>
        <a class="doc-btn" href="/cloud">
          About Veritio Cloud →
        </a>
      </div>
    </div>
  </Section>

  <Section id="next">
    <div class="max-w-2xl">
      <span class="eyebrow">Next</span>
      <h2 class="mt-4 text-2xl font-semibold tracking-tight text-ink">
        Set up the rest of Veritio Cloud
      </h2>
      <p class="mt-3 text-ink-soft">
        Onboarding covers signing up, choosing your data region, minting scoped
        keys, and requesting a verifiable export. Browse the full documentation
        for everything else.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a class="doc-btn doc-btn--solid" href="/docs/cloud-getting-started">
          Cloud getting started →
        </a>
        <a class="doc-btn" href="/docs">
          All documentation →
        </a>
      </div>
    </div>
  </Section>

  <Footer />
</BaseLayout>
