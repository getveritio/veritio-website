---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import Section from '../../components/Section.astro'

const githubRepo = 'https://github.com/getveritio/veritio'

/**
 * Document-style table of contents for the docs surface. Each entry is a row in
 * a dossier index — mono figure number, serif title, plain description, and a
 * destination. Internal routes use relative hrefs; external SDK/self-hosting
 * links point at the OSS repo. Kept as a data array so new docs pages slot in
 * without reworking the markup.
 */
const contents = [
  {
    n: '01',
    title: 'Cloud getting started',
    body:
      'Sign up, create an organization and data region, mint scoped API keys, send your first events, invite your team, and request a verifiable export.',
    href: '/docs/cloud-getting-started',
    external: false,
    kind: 'Guide',
  },
  {
    n: '02',
    title: 'Connect Claude Code & Codex',
    body:
      'Give your coding-agent sessions a hash-chained, tamper-evident audit trail, recorded to Veritio Cloud, with a hosted MCP to query it back.',
    href: '/docs/connect-agents',
    external: false,
    kind: 'Guide',
  },
  {
    n: '03',
    title: 'SDK examples',
    body:
      'Copy-pasteable TypeScript, Python, and Go examples for recording audit events and evidence edges — no hosted account required.',
    href: '/examples',
    external: false,
    kind: 'Reference',
  },
  {
    n: '04',
    title: 'OSS repository & self-hosting',
    body:
      'The open-source protocol, SDKs, framework adapters, storage helpers, verifier, and conformance fixtures. Run Veritio entirely on your own infrastructure.',
    href: githubRepo,
    external: true,
    kind: 'Source',
  },
  {
    n: '05',
    title: 'Pricing & quotas',
    body:
      'Plan limits for projects, monthly events, and export bundles, and where the hosted product fits alongside the open-source SDK.',
    href: '/pricing',
    external: false,
    kind: 'Plans',
  },
]
---

<BaseLayout
  title="Documentation — Veritio"
  description="Veritio documentation: hosted Cloud onboarding, connecting Claude Code and Codex, the open-source SDKs, self-hosting, and pricing."
>
  <Nav />

  <section class="py-16 sm:py-20">
    <div class="container">
      <span class="eyebrow">Documentation</span>
      <h1
        class="mt-4 max-w-3xl font-semibold tracking-tight text-ink"
        style="font-size: var(--text-headline); line-height: var(--text-headline--line-height);"
      >
        Everything you need to record evidence
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">
        Veritio is a protocol-first evidence layer for audit trails, change
        provenance, and governance workflows. Start on the hosted Cloud or run
        the open-source SDK on your own infrastructure — the protocol and the
        exports are identical either way.
      </p>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-muted">
        Veritio produces compliance <em>evidence</em>; it does not make you
        compliant and is not legal advice.
      </p>
    </div>
  </section>

  <Section id="contents">
    <span class="eyebrow">Contents</span>
    <h2 class="mt-4 text-2xl font-semibold tracking-tight text-ink">
      Table of contents
    </h2>

    <ol class="mt-10 max-w-3xl border-t border-line">
      {
        contents.map((item) => (
          <li class="border-b border-line">
            <a
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
              class="group grid grid-cols-[auto_1fr] gap-x-6 gap-y-1 py-6 no-underline sm:grid-cols-[auto_1fr_auto] sm:items-baseline"
            >
              <span class="font-mono text-sm text-ink-muted">{item.n}</span>
              <span>
                <span class="text-lg font-semibold text-ink transition-colors group-hover:text-accent">
                  {item.title}
                  {item.external && <span aria-hidden="true"> ↗</span>}
                  {!item.external && (
                    <span
                      aria-hidden="true"
                      class="text-ink-muted transition-colors group-hover:text-accent"
                    >
                      {' '}
                      →
                    </span>
                  )}
                </span>
                <span class="mt-2 block text-sm leading-relaxed text-ink-soft">
                  {item.body}
                </span>
              </span>
              <span class="col-start-2 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-muted sm:col-start-3 sm:text-right">
                {item.kind}
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="paths" tone="sunken">
    <span class="eyebrow">Two ways to run</span>
    <h2 class="mt-4 text-2xl font-semibold tracking-tight text-ink">
      Hosted or self-hosted
    </h2>
    <div class="mt-8 grid gap-10 sm:grid-cols-2">
      <div>
        <h3 class="text-base font-semibold text-ink">Veritio Cloud</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          Managed ingest, storage in your chosen region, a hosted MCP, and
          signed export bundles. Sign up and send events in minutes.
        </p>
        <a
          class="mt-5 inline-block font-mono text-[13px] uppercase tracking-[0.08em] text-accent no-underline hover:text-accent-strong"
          href="/docs/cloud-getting-started"
        >
          Cloud getting started →
        </a>
      </div>
      <div>
        <h3 class="text-base font-semibold text-ink">Open source</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          The same protocol, SDKs, and verifier — run entirely on your own
          infrastructure with no account. The exports verify offline.
        </p>
        <a
          class="mt-5 inline-block font-mono text-[13px] uppercase tracking-[0.08em] text-accent no-underline hover:text-accent-strong"
          href={githubRepo}
          target="_blank"
          rel="noopener noreferrer"
        >
          View on GitHub ↗
        </a>
      </div>
    </div>
  </Section>

  <Footer />
</BaseLayout>
