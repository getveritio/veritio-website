---
import BaseLayout from '../layouts/BaseLayout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Section from '../components/Section.astro'
import CodeBlock from '../components/CodeBlock.astro'
import FeatureCard from '../components/FeatureCard.astro'
import typescriptQuickstart from '../examples/quickstart/typescript.ts?raw'
import pythonQuickstart from '../examples/quickstart/python.py?raw'
import goQuickstart from '../examples/quickstart/go.go?raw'

const installTs = `npm install @veritio/core@0.4.7
# or
bun add @veritio/core@0.4.7`

const installPy = `git clone https://github.com/getveritio/veritio.git
git -C veritio checkout c4100ee7b678d0c6b227c67ae6ea1d8a1f373967
pip install -e ./veritio/sdks/python`

const installGo = `go get github.com/getveritio/veritio/sdks/go@c4100ee7b678d0c6b227c67ae6ea1d8a1f373967`

const workbench = `veritio dev --mcp`

const githubRepo = 'https://github.com/getveritio/veritio'
const referenceExample =
  'https://github.com/getveritio/veritio/tree/main/examples/nextjs-better-auth'

const adapters = [
  {
    title: 'Better Auth',
    body: 'Record user, session, and invitation events.',
  },
  {
    title: 'Next.js',
    body: 'Record evidence from server route handlers and server actions.',
  },
  {
    title: 'TanStack Start',
    body: 'Server-side evidence recording.',
  },
  {
    title: 'SvelteKit',
    body: 'Server-side evidence recording.',
  },
  {
    title: 'React / Vue / Svelte',
    body: 'UI intent helpers that annotate the interface (no client-side recording).',
  },
]
---

<BaseLayout
  title="Examples — Veritio"
  description="Real, copy-pasteable examples for recording audit events and evidence edges with the open-source Veritio SDKs. No hosted account required."
>
  <Nav />

  <main id="main-content">
  <section class="py-16 sm:py-20">
    <div class="container">
      <span class="eyebrow">Examples</span>
      <h1
        class="mt-4 max-w-3xl font-semibold tracking-tight text-ink"
        style="font-size: var(--text-headline); line-height: var(--text-headline--line-height);"
      >
        Integrate Veritio in minutes
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">
        These are real, copy-pasteable examples using the open-source SDKs. No
        hosted account required — everything below runs against the local,
        self-hostable packages.
      </p>
    </div>
  </section>

  <Section id="install">
    <h2 class="text-2xl font-semibold tracking-tight text-ink">Install</h2>
    <p class="mt-3 max-w-2xl text-ink-soft">
      TypeScript is published as an exact package version. Python and Go are
      currently installed from the public source tree.
    </p>
    <div class="mt-8 grid gap-5 lg:grid-cols-3">
      <CodeBlock code={installTs} lang="bash" title="TypeScript" />
      <CodeBlock code={installPy} lang="bash" title="Python" />
      <CodeBlock code={installGo} lang="bash" title="Go" />
    </div>
  </Section>

  <Section id="record-event">
    <h2 class="text-2xl font-semibold tracking-tight text-ink">
      Record your first event
    </h2>
    <p class="mt-3 max-w-2xl text-ink-soft">
      Append a structured audit event, read the tenant chain, and verify it.
    </p>
    <div class="mt-8">
      <CodeBlock code={typescriptQuickstart} lang="ts" title="typescript.ts" />
    </div>
    <p class="mt-5 max-w-2xl text-sm leading-relaxed text-ink-soft">
      This fixture is imported directly from the checked example source and is
      type-checked against <code class="inline">@veritio/core@0.4.7</code>.
    </p>
  </Section>

  <Section id="python-edges" tone="sunken">
    <h2 class="text-2xl font-semibold tracking-tight text-ink">
      The same event in Python
    </h2>
    <p class="mt-3 max-w-2xl text-ink-soft">
      Create and hash the equivalent event with the source-backed Python SDK.
    </p>
    <div class="mt-8">
      <CodeBlock code={pythonQuickstart} lang="python" title="python.py" />
    </div>
  </Section>

  <Section id="go-event">
    <h2 class="text-2xl font-semibold tracking-tight text-ink">The same event in Go</h2>
    <p class="mt-3 max-w-2xl text-ink-soft">
      The Go fixture uses the same actor, action, target, scope, purpose, lawful
      basis, retention label, and metadata as the TypeScript and Python versions.
    </p>
    <div class="mt-8">
      <CodeBlock code={goQuickstart} lang="go" title="main.go" />
    </div>
  </Section>

  <Section id="workbench">
    <h2 class="text-2xl font-semibold tracking-tight text-ink">
      Local Workbench
    </h2>
    <p class="mt-3 max-w-2xl text-ink-soft">
      Run the Workbench from your terminal to explore evidence locally.
    </p>
    <div class="mt-8 max-w-2xl">
      <CodeBlock code={workbench} lang="bash" title="terminal" />
    </div>
    <p class="mt-5 max-w-2xl text-sm leading-relaxed text-ink-soft">
      Run this command from a source checkout. It starts the local Workbench and
      MCP tooling with no hosted account required.
    </p>
  </Section>

  <Section id="frameworks" tone="sunken">
    <h2 class="text-2xl font-semibold tracking-tight text-ink">
      Framework integrations
    </h2>
    <p class="mt-3 max-w-2xl text-ink-soft">
      Shipped adapters wire evidence recording into popular frameworks with
      minimal glue code.
    </p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {
        adapters.map((adapter) => (
          <FeatureCard title={adapter.title}>{adapter.body}</FeatureCard>
        ))
      }
    </div>

    <div
      class="mt-8 rounded-xl border border-line bg-surface-raised p-6"
    >
      <p class="text-sm leading-relaxed text-ink-soft">
        See the full reference example combining
        <strong class="text-ink">Next.js + Better Auth</strong>:
        <a
          class="text-accent no-underline hover:text-accent-strong"
          href={referenceExample}
          target="_blank"
          rel="noopener noreferrer"
        >
          examples/nextjs-better-auth →
        </a>
      </p>
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <span
        class="inline-flex items-center border border-line-strong bg-surface px-3 py-1 font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-ink-muted"
      >
        Planned
      </span>
      <p class="text-sm text-ink-muted">
        Express, Hono, tRPC, and FastAPI adapters are planned and not yet
        available.
      </p>
    </div>
  </Section>

  <Section id="cta">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-semibold tracking-tight text-ink">
        Start with the open source
      </h2>
      <p class="mt-3 text-ink-soft">
        Clone the repo, read the protocol, and run the examples above. Veritio
        provides evidence support for your audit trails — you stay in control of
        where it runs.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a
          class="doc-btn doc-btn--solid"
          href={githubRepo}
          target="_blank"
          rel="noopener noreferrer"
        >
          View on GitHub
        </a>
        <a
          class="doc-btn"
          href="/cloud/"
        >
          When you want it hosted →
        </a>
      </div>
    </div>
  </Section>
  </main>

  <Footer />
</BaseLayout>
