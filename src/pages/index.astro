---
/**
 * Landing page, structured as an evidence dossier that argues a case: cover
 * statement + live Evidence Console, then 01 the situation (why logs fail),
 * 02 anatomy of a real record (hover cross-highlighting), 03 the verifier
 * catching tampering, 04 getting started, closing with the Veritio Cloud
 * pitch (the paid service — sold, not footnoted, but always optional). Mono is
 * reserved for data/labels, serif for prose; hairline rules instead of cards.
 * Both exhibits are real console captures (demonstration data) — the page
 * ships no client JavaScript.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import CodeBlock from '../components/CodeBlock.astro'
import { Image } from 'astro:assets'
import consoleShot from '../assets/console-dashboard.png'
import episodeShot from '../assets/episode-canvas.png'

const quickstartCode = `import { MemoryAuditStore, createAuditEvent } from "@veritio/core";

const store = new MemoryAuditStore();

const event = createAuditEvent({
  id: "evt_01",
  occurredAt: "2026-06-10T00:00:00.000Z",
  actor: { type: "user", id: "usr_123" },
  action: "org.member.invited",
  target: { type: "organization", id: "org_123" },
  scope: { tenantId: "org_123", environment: "production" },
  purpose: "access_management",
  lawfulBasis: "contract",
  retention: "security_1y",
  metadata: { inviteId: "inv_123", role: "viewer" },
});

await store.append(event);`

/**
 * Record #4 from the hero episode (the production table drop), shaped exactly
 * like the SDK's AuditRecord envelope. Hash tails match the hero's
 * illustrative chain (5db8 → c1a7); riskSignals are the conformance-fixture
 * inputs behind the 1.0/critical score shown in the recorder.
 *
 * The JSON is hand-marked HTML (rendered via set:html) instead of a Shiki
 * block so semantic regions carry data-r attributes: hovering a region
 * cross-highlights its margin note and vice versa, via pure-CSS :has() rules
 * (see the style block at the bottom of this file — no client JS).
 */
const kk = (name: string) => `<span class="k">"${name}"</span>`
const sv = (v: string) => `<span class="s">"${v}"</span>`
const nv = (v: number) => `<span class="n">${v}</span>`

const recordHtml = `{
  <span class="rgn" data-r="chain"><sup class="mk">01</sup>${kk('sequence')}: ${nv(4)},
  ${kk('previousHash')}: ${sv('5db8…')},</span>
  <span class="rgn" data-r="hash"><sup class="mk">02</sup>${kk('hash')}: ${sv('c1a7…')},
  ${kk('hashAlgorithm')}: ${sv('sha256')},
  ${kk('canonicalization')}: ${sv('veritio-json-v1')},</span>
  ${kk('appendedAt')}: ${sv('2026-06-23T00:03:00.412Z')},
  <span class="rgn" data-r="event"><sup class="mk">03</sup>${kk('event')}: {
    ${kk('id')}: ${sv('evt_9f27a1c4')},
    ${kk('occurredAt')}: ${sv('2026-06-23T00:03:00.000Z')},
    ${kk('action')}: ${sv('deploy.deployed')},
    ${kk('actor')}: {
      ${kk('type')}: ${sv('service')},
      ${kk('id')}: ${sv('svc_deploy')}
    },
    ${kk('target')}: {
      ${kk('type')}: ${sv('deployment')},
      ${kk('id')}: ${sv('dep_0623')}
    },
    ${kk('scope')}: {
      ${kk('tenantId')}: ${sv('org_acme')},
      ${kk('environment')}: ${sv('production')}
    },
    ${kk('metadata')}: {
      ${kk('activityEpisodeId')}: ${sv('ep_7c21f0a3')},
      <span class="rgn" data-r="signals"><sup class="mk">04</sup>${kk('riskSignals')}: {
        ${kk('operationType')}: ${sv('destructive')},
        ${kk('reversibility')}: ${sv('irreversible')},
        ${kk('envCriticality')}: ${sv('production')},
        ${kk('dataVolume')}: ${nv(12000)},
        ${kk('fanOut')}: ${nv(12)},
        ${kk('referenceCount')}: ${nv(12)}
      }</span>
    }
  }</span>
}`

/**
 * Margin notes for the record anatomy, in code order. `r` keys pair each note
 * with its code region for the CSS cross-highlight.
 */
const recordNotes = [
  {
    r: 'chain',
    field: 'sequence · previousHash',
    body: 'Each record locks to the one before it, per tenant. Delete or reorder history and the chain stops verifying at exactly that point.',
  },
  {
    r: 'hash',
    field: 'hash · canonicalization',
    body: 'SHA-256 over canonical bytes (veritio-json-v1). Change one character anywhere in the record and this stops matching.',
  },
  {
    r: 'event',
    field: 'event',
    body: 'The protocol body: who (actor.type — user, service, or ai_agent), what (action, target), and where (tenant scope). Same field names in TypeScript, Python, and Go.',
  },
  {
    r: 'signals',
    field: 'metadata.riskSignals',
    body: 'The inputs behind the score in the recording above. The policy is open — recompute the score yourself and you get the same number.',
  },
]

/** Real verifier behavior: verifyAuditRecords returns {ok:false, index, reason} on tampering. */
const verifySnippet = `import { verifyAuditRecords } from "@veritio/core";

verifyAuditRecords(records);
// → { ok: true }

// Quietly promote someone in an old record:
records[2].event.metadata.role = "admin";

verifyAuditRecords(records);
// → { ok: false, index: 2, reason: "hash_mismatch" }

// Try deleting the record instead:
const gapped = records.filter((_, i) => i !== 2);

verifyAuditRecords(gapped);
// → { ok: false, index: 2, reason: "sequence_mismatch" }`

/** What ships in the open packages — the 04 · Get started manifest. */
const manifest = [
  { label: 'SDKs', value: '@veritio/core (TypeScript) · veritio (Python) · Go' },
  { label: 'Adapters', value: 'Better Auth, Next.js, TanStack Start, SvelteKit · UI intent helpers for React, Vue, Svelte' },
  { label: 'Storage', value: 'PostgreSQL/Neon, MySQL, MariaDB, MongoDB · Redis tip cache' },
  { label: 'Schemas', value: 'Audit events, evidence graph edges, export bundle format' },
  { label: 'Verifier', value: 'Chain verification in every SDK — re-runnable by auditors' },
  { label: 'Workbench', value: 'veritio dev --mcp: local evidence graph, scenario runner, MCP tools' },
]

const cloudMailto = 'mailto:hello@getveritio.com?subject=Veritio%20Cloud'
const cloudRegister = 'https://console.getveritio.com/register'

const cloudPoints = [
  'Managed ingest and durable retention',
  'A shared evidence graph across services',
  'Exports and verification on demand',
  'Team access and operational support',
]

const displayStyle =
  'font-size: var(--text-display); line-height: var(--text-display--line-height); letter-spacing: var(--text-display--letter-spacing);'

const headlineStyle =
  'font-size: var(--text-headline); line-height: var(--text-headline--line-height); letter-spacing: var(--text-headline--letter-spacing);'
---

<BaseLayout
  title="Veritio — Evidence Graph for Audit Trails, AI Changes, and Governance"
  description="Open-source evidence layer to record, connect, verify, and export application events, code changes, agent sessions, deployments, consent history, and retention decisions. Optional managed vault."
>
  <Nav />

  <main>
    <!-- COVER -->
    <section>
      <div class="container">
        <div class="border-b border-line py-3 font-mono text-[11px] uppercase tracking-[0.16em] text-ink-muted">
          Open-source evidence layer
        </div>

        <h1 class="max-w-[17ch] pt-12 font-medium text-ink sm:pt-16" style={displayStyle}>
          Who did what, how risky it was, and proof it happened.
        </h1>

        <div class="grid gap-8 pb-12 pt-8 lg:grid-cols-[1fr_auto] lg:items-end">
          <p class="max-w-2xl text-lg leading-relaxed text-ink-soft sm:text-xl">
            Veritio records application events, agent sessions, code changes, and
            deployments as hash-linked audit events — with origin and a
            deterministic risk score on every step — that anyone can independently
            verify and export. Evidence support for reviews and
            investigations, <em>not</em> automatic compliance.
          </p>
          <div class="flex flex-wrap items-center gap-3">
            <a
              href="https://github.com/getveritio/veritio"
              target="_blank"
              rel="noopener noreferrer"
              class="doc-btn doc-btn--solid"
            >
              View on GitHub ↗
            </a>
            <a href="/examples" class="doc-btn">See examples</a>
          </div>
        </div>
      </div>
    </section>

    <!-- EXHIBIT A: the Evidence Console -->
    <section>
      <div class="container pb-16 sm:pb-20">
        <div
          class="relative overflow-hidden rounded-xl"
          style="aspect-ratio: 2880 / 1634; background: #0c1a14; border: 1px solid #c6bda1; width: min(100vw - 32px, 1520px); margin-inline: calc((100% - min(100vw - 32px, 1520px)) / 2);"
        >
          <Image
            src={consoleShot}
            alt="Veritio Cloud console in dark mode: the Operations dashboard with an evidence stream of hash-linked tool calls, code changes, and deploys, each with a risk score, above a critical episode's risk timeline."
            widths={[760, 1520, 2880]}
            sizes="(min-width: 1600px) 1520px, calc(100vw - 32px)"
            quality={90}
            loading="eager"
            class="block h-full w-full object-cover object-top"
          />
        </div>

        <p class="mt-3 font-mono text-[11.5px] leading-relaxed tracking-[0.02em] text-ink-muted">
          Veritio Cloud · Operations console — captured from a reference
          deployment running <code class="inline">@veritio/core</code> risk
          scoring under policy <code class="inline">veritio.reference.v1</code>.
          Demonstration data.
        </p>
      </div>
    </section>

    <!-- § 01 · THE SITUATION -->
    <section class="border-t border-line-strong bg-surface-raised">
      <div class="container py-16 sm:py-20">
        <div>
          <div>
            <h2 class="max-w-[20ch] font-medium text-ink" style={headlineStyle}>
              Software ships itself now.
            </h2>
            <p class="mt-8 max-w-[52ch] text-[22px] leading-[1.5] text-ink">
              An agent writes the migration. A pipeline approves it. A service
              deploys it to production at three in the morning. The work is real
              — and so are the questions that follow it: <em>who did this, under
              whose review, and how dangerous was it?</em>
            </p>
            <p class="mt-6 max-w-[58ch] text-[17px] leading-relaxed text-ink-soft">
              Application logs weren't built to answer. They rotate, they get
              rewritten, and they belong to whoever holds the database. Veritio
              turns each action into a record instead: an origin — user, service,
              or AI agent — a deterministic risk score, and a hash that locks it
              into sequence. Evidence, not logs.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- § 02 · THE RECORD -->
    <section class="border-t border-line-strong">
      <div class="container py-16 sm:py-20">
        <div>
          <div>
            <h2 class="max-w-[22ch] font-medium text-ink" style={headlineStyle}>
              Anatomy of a record.
            </h2>
            <p class="mt-5 max-w-[58ch] text-[17px] leading-relaxed text-ink-soft">
              This is the fourth record from the recording above — the production
              table drop — exactly as an SDK stores it. Hashes truncated for
              print.
            </p>
            <div class="anatomy mt-8 grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
              <div class="code-frame">
                <div class="flex items-center justify-between border-b border-code-border bg-surface-sunken px-4 py-2">
                  <span class="font-mono text-xs text-ink-muted">record #4 · deploy.deployed</span>
                  <span class="font-mono text-[11px] uppercase tracking-wider text-ink-muted">json</span>
                </div>
                <pre class="anatomy-pre" set:html={recordHtml} />
              </div>
              <div>
                <ol class="m-0 list-none space-y-1 p-0">
                  {
                    recordNotes.map((note, i) => (
                      <li class="note flex gap-4 border-b border-line py-4" data-r={note.r}>
                        <span class="font-mono text-[13px] font-medium text-accent">{String(i + 1).padStart(2, '0')}</span>
                        <div>
                          <h3 class="m-0 font-mono text-[13px] font-medium tracking-[0.02em] text-ink">
                            {note.field}
                          </h3>
                          <p class="mb-0 mt-1.5 text-[15px] leading-relaxed text-ink-muted">{note.body}</p>
                        </div>
                      </li>
                    ))
                  }
                </ol>
                <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.14em] text-ink-muted">
                  Hover a note — or the record — to cross-highlight
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- § 03 · THE PROOF -->
    <section class="border-t border-line-strong bg-surface-raised">
      <div class="container py-16 sm:py-20">
        <div>
          <div>
            <h2 class="max-w-[22ch] font-medium text-ink" style={headlineStyle}>
              Edit one byte. The chain notices.
            </h2>
            <div class="mt-8 grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
              <div class="space-y-5 text-[17px] leading-relaxed text-ink-soft">
                <p>
                  An audit trail is only as good as its answer to one
                  question: <em>how do I know nobody touched it?</em>
                </p>
                <p>
                  Veritio's answer is arithmetic, not access control. The verifier
                  re-derives every hash from the canonical bytes and walks the
                  chain, so mutation, deletion, and reordering all surface — with
                  the exact position where history diverged.
                </p>
                <p>
                  And because the verifier ships in the open packages, an auditor
                  doesn't have to trust your database, your admins, or us.
                </p>
              </div>
              <CodeBlock code={verifySnippet} lang="ts" title="verify.ts" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- § 04 · GET STARTED -->
    <section class="border-t border-line-strong">
      <div class="container py-16 sm:py-20">
        <div>
          <div>
            <h2 class="max-w-[22ch] font-medium text-ink" style={headlineStyle}>
              Start in your own stack.
            </h2>
            <p class="mt-5 max-w-[58ch] text-[17px] leading-relaxed text-ink-soft">
              Install the SDK, create an audit event, append it to a store. The
              in-memory store runs anywhere, so you can record and verify
              evidence before you wire up durable storage.
            </p>
            <div class="mt-8 grid gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
              <CodeBlock code={quickstartCode} lang="ts" title="audit-event.ts" />
              <div>
                <h3 class="font-mono text-[11px] font-medium uppercase tracking-[0.18em] text-ink-muted">
                  In the box
                </h3>
                <dl class="mt-3 border-t border-line-strong">
                  {
                    manifest.map((row) => (
                      <div class="grid grid-cols-[110px_1fr] gap-4 border-b border-line py-3.5">
                        <dt class="font-mono text-[12px] font-medium uppercase tracking-[0.08em] text-accent">
                          {row.label}
                        </dt>
                        <dd class="m-0 text-[14.5px] leading-relaxed text-ink-soft">{row.value}</dd>
                      </div>
                    ))
                  }
                </dl>
                <div class="mt-7 flex flex-wrap gap-3">
                  <a
                    href="https://github.com/getveritio/veritio"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="doc-btn doc-btn--solid"
                  >
                    View on GitHub ↗
                  </a>
                  <a href="/examples" class="doc-btn">See examples</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- VERITIO CLOUD -->
    <section class="border-t border-line-strong bg-evergreen">
      <div class="container py-18 sm:py-24">
        <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
          <div>
            <svg width="88" height="88" viewBox="0 0 112 112" aria-hidden="true" class="-rotate-6">
              <defs>
                <path id="sealArc" d="M 56 14 A 42 42 0 1 1 55.99 14" fill="none"></path>
              </defs>
              <circle cx="56" cy="56" r="52" fill="none" stroke="#f6f3ea" stroke-width="1.5"></circle>
              <circle cx="56" cy="56" r="42" fill="none" stroke="#f6f3ea" stroke-width="0.75"></circle>
              <text
                font-family='"IBM Plex Mono", monospace'
                font-size="9.5"
                letter-spacing="1.4"
                fill="#f6f3ea"
              >
                <textPath href="#sealArc">RECORD · VERIFY · EXPORT · VERITIO ·</textPath>
              </text>
              <path d="M46 56 L53 63 L67 47" fill="none" stroke="#f6f3ea" stroke-width="2.5" stroke-linecap="square"></path>
            </svg>
            <h2 class="mt-7 max-w-[18ch] font-medium text-surface" style={headlineStyle}>
              Or let us run it.
            </h2>
            <p class="mt-5 max-w-[54ch] text-[17px] leading-relaxed text-surface/85">
              Veritio Cloud is the managed way to run the same open protocol: we
              operate ingest, storage, retention, and exports — you keep evidence
              that anyone can verify without trusting us. The open-source path
              always works on its own; Cloud is for teams that would rather buy
              the operations than staff them.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-4">
              <a
                href={cloudRegister}
                target="_blank"
                rel="noopener noreferrer"
                class="doc-btn"
                style="border-color: var(--color-surface); color: var(--color-surface);"
              >
                Create an account ↗
              </a>
              <a
                href="/pricing"
                class="font-mono text-[13px] font-medium uppercase tracking-[0.08em] text-surface/85 no-underline hover:text-surface"
              >
                See pricing →
              </a>
              <a
                href={cloudMailto}
                class="font-mono text-[13px] font-medium uppercase tracking-[0.08em] text-surface/60 no-underline hover:text-surface"
              >
                Talk to us
              </a>
            </div>
          </div>
          <ul class="space-y-4 border-t border-surface/20 pt-6 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
            {
              cloudPoints.map((point) => (
                <li class="flex items-baseline gap-3 border-b border-surface/15 pb-4 text-[16px] text-surface/90">
                  <span class="font-mono text-[12px] text-surface/60">·</span>
                  <span>{point}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- The same episode, tracked visually: a real capture of Cloud's episode canvas. -->
        <div class="mt-14">
          <div
            class="relative overflow-hidden rounded-xl"
            style="aspect-ratio: 2880 / 1480; background: #0c1a14; border: 1px solid rgba(246, 243, 234, 0.22);"
          >
            <Image
              src={episodeShot}
              alt="Veritio Cloud episode canvas: a critical activity episode's events — security risk, tool calls, a code change, and a deployment — laid out as connected cards, with the episode's critical-risk rollup in the corner."
              widths={[760, 1520, 2880]}
              sizes="(min-width: 1280px) 1180px, 100vw"
              quality={90}
              loading="lazy"
              class="block h-full w-full object-cover object-top"
            />
          </div>
          <p class="mt-3 font-mono text-[11.5px] leading-relaxed tracking-[0.02em] text-surface/60">
            The same records on Veritio Cloud's episode canvas — scores and
            chain, tracked visually instead of as a list. Demonstration data.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<!--
  Record-anatomy cross-highlight. Pure CSS via :has() — hovering a code
  region highlights its margin note and vice versa; no client JS, keeping the
  Remotion island the page's only script. `is:global` because the JSON's
  region spans are injected with set:html and never receive Astro's scoping
  attribute.
-->
<style is:global>
  .anatomy-pre {
    margin: 0;
    padding: 18px 20px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    overflow-x: auto;
    color: var(--color-ink-muted);
  }

  .anatomy-pre .k {
    color: var(--color-ink);
  }

  .anatomy-pre .s {
    color: var(--color-accent-strong);
  }

  .anatomy-pre .n {
    color: var(--color-seal);
  }

  .anatomy-pre .rgn {
    position: relative;
    border-radius: 2px;
    transition: background-color 0.12s ease;
  }

  /* Region marker floats in the gutter so keys stay column-aligned. */
  .anatomy-pre .mk {
    position: absolute;
    left: -17px;
    top: 3px;
    font-size: 9px;
    line-height: 1;
    color: var(--color-seal);
    user-select: none;
  }

  .anatomy .note {
    border-left: 2px solid transparent;
    padding-left: 14px;
    margin-left: -16px;
    transition:
      background-color 0.12s ease,
      border-color 0.12s ease;
  }

  /* Pairing rules: one pair per region key. */
  .anatomy:has(.rgn[data-r='chain']:hover) .rgn[data-r='chain'],
  .anatomy:has(.note[data-r='chain']:hover) .rgn[data-r='chain'],
  .anatomy:has(.rgn[data-r='hash']:hover) .rgn[data-r='hash'],
  .anatomy:has(.note[data-r='hash']:hover) .rgn[data-r='hash'],
  .anatomy:has(.rgn[data-r='event']:hover) .rgn[data-r='event'],
  .anatomy:has(.note[data-r='event']:hover) .rgn[data-r='event'],
  .anatomy:has(.rgn[data-r='signals']:hover) .rgn[data-r='signals'],
  .anatomy:has(.note[data-r='signals']:hover) .rgn[data-r='signals'] {
    background-color: rgba(47, 111, 87, 0.13);
  }

  .anatomy:has(.rgn[data-r='chain']:hover) .note[data-r='chain'],
  .anatomy:has(.note[data-r='chain']:hover) .note[data-r='chain'],
  .anatomy:has(.rgn[data-r='hash']:hover) .note[data-r='hash'],
  .anatomy:has(.note[data-r='hash']:hover) .note[data-r='hash'],
  .anatomy:has(.rgn[data-r='event']:hover) .note[data-r='event'],
  .anatomy:has(.note[data-r='event']:hover) .note[data-r='event'],
  .anatomy:has(.rgn[data-r='signals']:hover) .note[data-r='signals'],
  .anatomy:has(.note[data-r='signals']:hover) .note[data-r='signals'] {
    background-color: var(--color-surface-sunken);
    border-left-color: var(--color-accent);
  }

  /* riskSignals nests inside event: when it is the hovered target, mute the
     enclosing event highlight so exactly one pair lights up. Order matters —
     these override the equal-specificity rules above. */
  .anatomy:has(.rgn[data-r='signals']:hover) .rgn[data-r='event'],
  .anatomy:has(.note[data-r='signals']:hover) .rgn[data-r='event'] {
    background-color: transparent;
  }

  .anatomy:has(.rgn[data-r='signals']:hover) .note[data-r='event'],
  .anatomy:has(.note[data-r='signals']:hover) .note[data-r='event'] {
    background-color: transparent;
    border-left-color: transparent;
  }
</style>
