---
/**
 * Korean Cloud page (/ko/cloud), localized from src/pages/cloud.astro.
 * Same claims discipline: managed service is optional, OSS stands alone.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import Section from '../../components/Section.astro'
import { Image } from 'astro:assets'
import dashboardShot from '../../assets/console-dashboard.png'
import episodesShot from '../../assets/console-episodes.png'
import changesShot from '../../assets/console-changes.png'
import exportsShot from '../../assets/console-exports.png'

const cloudRegister = 'https://console.getveritio.com/register'
const ossRepo = 'https://github.com/getveritio/veritio'
const headline =
  'font-size: var(--text-headline); line-height: var(--text-headline--line-height); letter-spacing: var(--text-headline--letter-spacing);'

const tour = [
  {
    label: '운영',
    title: '한 주를 점수로',
    body: '하나의 운영 화면: 최근 7일의 리스크별 에피소드, 무결성 검사 전의 거버넌스 변경, AI 요청 비용, 마지막 내보내기. 에비던스 스트림은 각 에피소드 롤업을 단계별로 재생합니다.',
    shot: dashboardShot,
    alt: 'Veritio Cloud 운영 콘솔: 이벤트별 리스크 점수와 해시 체인이 표시된 에비던스 스트림, 크리티컬 에피소드 리스크 타임라인, 리스크별 에피소드·최근 변경 패널.',
  },
  {
    label: '에피소드',
    title: '로그 양이 아니라 리스크로 트리아지',
    body: '모든 활동 에피소드는 하나의 에피소드 ID로 연결되고 파생 리스크 롤업 — 피크, 속도, 단계 수, 기간 — 을 갖습니다. 실제로 리뷰어가 필요한 것부터 정렬하세요.',
    shot: episodesShot,
    alt: 'Veritio Cloud 에피소드 목록: Low와 Critical 리스크 롤업, 단계 수, 세션, UTC 기간이 표시된 60개의 활동 에피소드.',
  },
  {
    label: '거버넌스 변경',
    title: '의도와 권한이 있는 변경',
    body: '거버넌스 변경은 누가, 어떤 권한으로 시작했는지, 입력·출력 리비전과 어서션까지 기록합니다 — 원시 감사 이벤트 위의 제품 단위이며, 해시 체인으로 검증됩니다.',
    shot: changesShot,
    alt: 'Veritio Cloud 거버넌스 변경: 시작 사용자, 상태, 출력, 입력, "Hash-chain verified" 배지가 표시된 다섯 건의 데이터 테이블 변경.',
  },
  {
    label: '내보내기',
    title: '넘겨줄 수 있는 증거',
    body: '원하는 기간과 프로젝트 범위로 번들을 요청하세요. 각 내보내기는 매니페스트 해시, 리전, 다운로드와 함께 생성되며 — 오픈 소스 검증기로 독립적으로 검증할 수 있습니다.',
    shot: exportsShot,
    alt: 'Veritio Cloud 내보내기: 매니페스트 해시, 기간, EU 리전 배지, 다운로드 버튼이 있는 두 개의 준비된 내보내기 번들.',
  },
]

const capabilities = [
  ['관리형 수집(Ingest)', '호스팅된 엔드포인트가 증거를 수신합니다 — 파이프라인을 직접 운영할 필요가 없습니다.'],
  ['스코프 키', '수집·읽기·내보내기·관리 권한별로 분리된 토큰.'],
  ['추가 전용 저장소', '내구성 있는 불변 에비던스 저장소를 대신 운영합니다.'],
  ['그래프 프로젝션', '증거가 자동으로 연결된 그래프로 투영됩니다.'],
  ['내보내기', '요청 시 내보내기 번들을 생성하고 전달합니다.'],
  ['리전 저장', '가입 시 리전 선택 — EU 관할권, US, APAC.'],
]
---

<BaseLayout
  title="Veritio Cloud — 호스팅형 에비던스 운영"
  description="Veritio Cloud는 Veritio를 위한 선택형 관리 서비스입니다. 같은 오픈 프로토콜에 관리형 인프라와 운영을 더합니다."
>
  <Nav />

  <section
    class="py-20 sm:py-28"
    style="background-image: linear-gradient(180deg, rgb(248 250 247 / 86%), rgb(248 250 247 / 97%)), url('/evidence-grid.svg'); background-size: cover;"
  >
    <div class="container">
      <span class="eyebrow">Veritio Cloud · 선택형 관리 서비스</span>
      <h1
        class="mt-5 max-w-4xl font-semibold text-ink"
        style="font-size: var(--text-display); line-height: var(--text-display--line-height); letter-spacing: var(--text-display--letter-spacing);"
      >
        호스팅형 에비던스 운영, 당신의 조건으로.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
        Veritio Cloud는 Veritio를 운영하는 선택형 관리 방식이며, 지금 열려
        있습니다. SDK 및 셀프 호스팅 서버와 같은 오픈 프로토콜을 사용하고, 그
        위에 관리형 인프라와 운영을 더합니다. 오픈 소스 경로는 언제나
        단독으로 동작합니다 — Cloud는 직접 운영하고 싶지 않을 때를 위한
        것입니다.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={cloudRegister} target="_blank" rel="noopener noreferrer" class="doc-btn doc-btn--solid">
          계정 만들기 ↗
        </a>
        <a href="/ko/pricing" class="doc-btn">요금 보기</a>
        <a href={ossRepo} target="_blank" rel="noopener noreferrer" class="doc-btn">
          오픈 소스 SDK 사용
        </a>
      </div>
    </div>
  </section>

  <Section id="tour" tone="raised" bordered>
    <span class="eyebrow">콘솔 투어</span>
    <h2 class="mt-4 max-w-2xl font-semibold text-ink" style={headline}>
      실제 콘솔 화면
    </h2>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-soft">
      오픈 리스크 정책을 실행 중인 레퍼런스 배포의 캡처입니다. 전부 데모
      데이터입니다.
    </p>

    <div class="mt-12 flex flex-col gap-16">
      {
        tour.map((t) => (
          <div>
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <span class="font-mono text-[11px] uppercase tracking-[0.16em] text-accent">{t.label}</span>
              <h3 class="text-lg font-semibold text-ink">{t.title}</h3>
            </div>
            <p class="mt-2 max-w-2xl text-base leading-relaxed text-ink-soft">{t.body}</p>
            <div class="mt-5 overflow-hidden rounded-xl" style="background: #0c1a14; border: 1px solid #c6bda1;">
              <Image
                src={t.shot}
                alt={t.alt}
                widths={[720, 1440, 2880]}
                sizes="(min-width: 1200px) 1116px, 100vw"
                quality={90}
                loading="lazy"
                class="block h-auto w-full"
              />
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <Section id="capabilities">
    <span class="eyebrow">관리형 기능</span>
    <h2 class="mt-4 max-w-2xl font-semibold text-ink" style={headline}>
      호스팅 서비스가 더하는 것
    </h2>
    <div class="mt-8 grid gap-x-10 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        capabilities.map(([title, body]) => (
          <div class="border-t border-line pt-4">
            <h3 class="text-base font-semibold text-ink">{title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <section class="border-t border-line bg-evergreen py-16 text-surface sm:py-20">
    <div class="container">
      <h2 class="max-w-2xl font-semibold" style={headline}>
        호스팅형 Veritio가 필요하신가요?
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-surface/80">
        Veritio Cloud는 지금 열려 있습니다. 가입 시 리전을 선택하고 오늘부터
        검증 가능한 증거를 기록하세요 — 결제 기능 오픈 전까지 카드가 필요
        없습니다.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href={cloudRegister}
          target="_blank"
          rel="noopener noreferrer"
          class="doc-btn"
          style="border-color: var(--color-surface); color: var(--color-surface);"
        >
          계정 만들기 ↗
        </a>
        <a
          href="/ko/pricing"
          class="font-mono text-[13px] font-medium uppercase tracking-[0.08em] text-surface/85 no-underline hover:text-surface"
        >
          요금 보기 →
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
