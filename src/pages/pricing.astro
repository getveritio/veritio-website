---
/**
 * Pricing page in the dossier system: a hairline rate table (plans as columns,
 * terms as rows), a manifest of what ships on every plan, a fenced roadmap of
 * catalog capabilities that are not built yet, and plain billing notes.
 * Numbers mirror veritio-cloud src/billing/plans.ts exactly (ladder v2,
 * 2026-07-18: no free tier — the free path is self-hosting the OSS) — that
 * file is the source of truth; do not edit prices here without changing it
 * there. Mono carries money and limits; serif carries prose. No client JS.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'

const registerUrl = 'https://console.getveritio.com/register'
const enterpriseMailto = 'mailto:hello@getveritio.com?subject=Veritio%20Cloud%20Enterprise'

/** Plan columns. Prices mirror plans.ts (USD). */
const plans = [
  { id: 'pro', name: 'Pro', monthly: '$29', annual: '$24.17', for: 'one person' },
  { id: 'team', name: 'Team', monthly: '$99', annual: '$82.50', for: 'up to a working team' },
  { id: 'compliance', name: 'Compliance', monthly: '$499', annual: '$415.83', for: 'audited organizations' },
  { id: 'enterprise', name: 'Enterprise', monthly: 'Custom', annual: '—', for: 'negotiated terms' },
]

/** Rate rows in plan-column order [Pro, Team, Compliance, Enterprise]. */
const rows = [
  { label: 'Projects', values: ['3', '3', '10', 'Unlimited'] },
  { label: 'Events / month', values: ['100,000', '500,000', '5,000,000', 'Custom'] },
  {
    label: 'Overage per 100k',
    values: ['$10, to 2× allowance', '$10, to 2× allowance', '$10, to 2× allowance', 'Custom'],
  },
  { label: 'Retention', values: ['90 days', '365 days', '5 years', 'Custom'] },
  { label: 'Export bundles', values: ['5 / month', 'Unlimited', 'Unlimited', 'Custom'] },
  { label: 'Seats included', values: ['1', '5', '25', 'Custom'] },
  { label: 'Additional seat', values: ['—', '$15 / month', '$15 / month', 'Custom'] },
]

/** Capabilities live today, identical on every plan. */
const included = [
  ['Hash-chained audit trail', 'every event locked into a per-tenant sequence any party can re-verify'],
  ['Region choice at signup', 'tenant data lives in the region chosen at organization creation — EU jurisdiction, US, or APAC'],
  ['Agent and AI capture', 'agent sessions, code changes, and deployments recorded as first-class evidence'],
  ['Signed export bundles', 'vevb-1 bundles for reviews, DSAR responses, and investigations'],
  ['Risk scoring', 'deterministic per-step scores from the open veritio.reference.v1 policy'],
  ['Team invitations', 'role-based membership in every organization'],
] as const

/** Catalog capabilities that are NOT built yet. Fenced as roadmap, per tier. */
const roadmap = [
  {
    plan: 'Team',
    items: [
      ['Auditor role', 'read, verify, and export only — no keys, no settings, no member management; the role handed to an external auditor'],
    ],
  },
  {
    plan: 'Compliance',
    items: [
      ['Dedicated signing key', 'bundles signed with a key held for that tenant alone, not the shared platform key'],
      ['Framework evidence annexes', 'bundles annotated against the control frameworks auditors ask about'],
      ['Tunable risk policy', 'organization-set thresholds in place of the fixed reference policy'],
      ['Single sign-on', 'SAML login through the organization’s identity provider'],
    ],
  },
  {
    plan: 'Enterprise',
    items: [
      ['Negotiated provisions', 'customer-held keys, custom roles and SCIM, custom retention and export packs, SLA and onboarding'],
    ],
  },
] as const

/** Plain billing notes shown under the table. */
const notes = [
  'Billing is not live yet. Organizations created today run with Pro-plan limits at no charge and choose a plan when billing launches; no card is required until then.',
  'Annual billing runs a full year up front for the price of ten months.',
  'Overage never bills without bound: at twice the monthly allowance, ingest fails closed until the month resets or the plan changes.',
  'Events count appends only — reads, dashboards, exports, and verification are free. Agents, hooks, CI, and API keys are not seats.',
]

const headline =
  'font-size: var(--text-headline); line-height: var(--text-headline--line-height); letter-spacing: var(--text-headline--letter-spacing);'

/** Questions answered in plain text below the table; also emitted as FAQPage JSON-LD. */
const faq = [
  [
    'Is there a free plan?',
    'There is no free hosted tier. The free path is self-hosting the open-source stack — the protocol, SDKs, and offline verifier run without an account, and the exports are identical.',
  ],
  [
    'What counts as a billed event?',
    'Only appends count. Reads, dashboards, exports, and verification are free, and agents, hooks, CI jobs, and API keys are not seats.',
  ],
  [
    'What happens when the monthly event allowance runs out?',
    'Overage bills at $10 per 100,000 events up to twice the allowance. At the cap, ingest fails closed until the month resets or the plan changes — overage never bills without bound.',
  ],
  [
    'Where is tenant data stored?',
    'In the region chosen at organization creation — EU jurisdiction, US, or APAC. Evidence storage is pinned to that region.',
  ],
  [
    'When does billing start?',
    'Billing is not live yet. Organizations created today run with Pro-plan limits at no charge and choose a plan when billing launches; no card is required until then.',
  ],
  [
    'Does Veritio make my organization compliant?',
    'No. Veritio produces verifiable compliance evidence — hash-chained audit trails and signed export bundles. Whether an organization is compliant is decided by auditors against a framework, not by tooling.',
  ],
] as const

/**
 * Pricing structured data for search engines. Offer prices mirror the plan
 * columns above (and therefore veritio-cloud src/billing/plans.ts) — update all
 * three together. Enterprise is negotiated, so it carries no Offer. The
 * FAQPage entries mirror the visible `faq` list verbatim.
 */
const pricingJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(([q, a]) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Veritio Cloud',
    url: 'https://getveritio.com/cloud/',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    description:
      'Hosted evidence layer for audit trails, agent capture, risk scoring, and signed compliance-evidence export bundles.',
    offers: [
      { '@type': 'Offer', name: 'Pro', price: '29', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Team', price: '99', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Compliance', price: '499', priceCurrency: 'USD' },
    ],
  },
]
---

<BaseLayout
  title="Pricing — Veritio Cloud"
  description="Veritio Cloud plans: Pro $29, Team $99, Compliance $499, Enterprise custom. Self-hosting the open-source stack is free. Supports compliance evidence; it does not make you compliant."
  jsonLd={pricingJsonLd}
>
  <Nav />

  <main>
    <!-- COVER -->
    <section>
      <div class="container">
        <div class="border-b border-line py-3 font-mono text-[11px] uppercase tracking-[0.16em] text-ink-muted">
          Veritio Cloud · Pricing
        </div>

        <h1
          class="max-w-[14ch] pt-12 font-medium text-ink sm:pt-16"
          style="font-size: var(--text-display); line-height: var(--text-display--line-height); letter-spacing: var(--text-display--letter-spacing);"
        >
          Pricing.
        </h1>
        <p class="mt-6 max-w-[56ch] pb-14 text-lg leading-relaxed text-ink-soft">
          Four plans, one protocol. Every tier runs the same hash-chained
          evidence layer; the rates differ only in volume, retention, and seats.
          Self-hosting the <a href="/docs" class="underline decoration-line underline-offset-4 hover:text-ink">open-source stack</a> is free and always will be.
          Veritio supports compliance evidence; it does not make an organization
          compliant.
        </p>
      </div>
    </section>

    <!-- RATES -->
    <section class="border-t border-line-strong">
      <div class="container py-14 sm:py-16">
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-left align-top">
            <thead>
              <tr class="border-b border-line-strong">
                <th scope="col" class="w-[168px] min-w-[150px] py-5 pr-4 align-bottom">
                  <span class="font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-ink-muted">
                    Plan
                  </span>
                </th>
                {
                  plans.map((plan) => (
                    <th scope="col" class="min-w-[176px] border-l border-line px-5 py-5 align-bottom font-normal">
                      <div class="font-serif text-[22px] font-medium leading-none text-ink">{plan.name}</div>
                      <div class="mt-2 font-mono text-[11px] leading-relaxed text-ink-muted">for {plan.for}</div>
                      <div class="mt-4 font-mono text-[26px] font-medium leading-none text-ink">{plan.monthly}</div>
                      <div class="mt-2 font-mono text-[11px] leading-relaxed text-ink-muted">
                        {plan.annual === '—' ? 'contact us' : `per month · ${plan.annual} billed annually`}
                      </div>
                    </th>
                  ))
                }
              </tr>
            </thead>
            <tbody>
              {
                rows.map((row) => (
                  <tr class="border-b border-line">
                    <th
                      scope="row"
                      class="py-4 pr-4 text-left align-top font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-accent"
                    >
                      {row.label}
                    </th>
                    {row.values.map((value) => (
                      <td class="border-l border-line px-5 py-4 align-top font-mono text-[13.5px] leading-relaxed text-ink-soft">
                        {value}
                      </td>
                    ))}
                  </tr>
                ))
              }
              <tr>
                <th
                  scope="row"
                  class="py-4 pr-4 text-left align-top font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-ink-muted"
                >
                  Open
                </th>
                {
                  plans.map((plan) => (
                    <td class="border-l border-line px-5 py-4 align-top font-mono text-[12px]">
                      {plan.id === 'enterprise' ? (
                        <a href={enterpriseMailto} class="text-accent no-underline hover:underline">
                          write to us ↗
                        </a>
                      ) : (
                        <a
                          href={registerUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="text-accent no-underline hover:underline"
                        >
                          create account ↗
                        </a>
                      )}
                    </td>
                  ))
                }
              </tr>
            </tbody>
          </table>
        </div>
        <ul class="mt-6 grid max-w-[76ch] list-none gap-2 p-0">
          {notes.map((note) => <li class="font-mono text-[11px] leading-relaxed text-ink-muted">{note}</li>)}
        </ul>
      </div>
    </section>

    <!-- INCLUDED ON EVERY PLAN -->
    <section class="border-t border-line-strong bg-surface-raised">
      <div class="container py-14 sm:py-16">
        <h2 class="font-medium text-ink" style={headline}>Included on every plan</h2>
        <p class="mt-4 max-w-[58ch] text-[16px] leading-relaxed text-ink-soft">
          The protocol does not shrink at lower tiers. Each of the following is
          live today, identical from Pro to Enterprise.
        </p>
        <ul class="mt-8 grid list-none gap-x-12 border-t border-line-strong p-0 sm:grid-cols-2">
          {
            included.map(([name, body]) => (
              <li class="border-b border-line py-4">
                <span class="font-mono text-[12px] font-medium uppercase tracking-[0.08em] text-accent">{name}</span>
                <span class="mt-1 block max-w-[46ch] text-[15px] leading-relaxed text-ink-soft">{body}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- QUESTIONS -->
    <section class="border-t border-line-strong">
      <div class="container py-14 sm:py-16">
        <h2 class="font-medium text-ink" style={headline}>Questions</h2>
        <dl class="mt-8 border-t border-line-strong">
          {
            faq.map(([q, a]) => (
              <div class="grid gap-2 border-b border-line py-5 sm:grid-cols-[minmax(200px,320px)_1fr] sm:gap-8">
                <dt class="font-mono text-[12px] font-medium uppercase tracking-[0.08em] text-accent">{q}</dt>
                <dd class="m-0 max-w-[64ch] text-[15px] leading-relaxed text-ink-soft">{a}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- ON THE ROADMAP -->
    <section class="border-t border-line-strong">
      <div class="container py-14 sm:py-16">
        <h2 class="font-medium text-ink" style={headline}>On the roadmap</h2>
        <p class="mt-4 max-w-[58ch] text-[16px] leading-relaxed text-ink-soft">
          The plan catalog names capabilities that are not built yet. None is a
          shipped feature today.
        </p>
        <dl class="mt-8 border-t border-line-strong">
          {
            roadmap.map((tier) => (
              <div class="grid gap-3 border-b border-line py-5 sm:grid-cols-[168px_1fr] sm:gap-8">
                <dt class="font-mono text-[12px] font-medium uppercase tracking-[0.1em] text-ink-muted">{tier.plan}</dt>
                <dd class="m-0 grid gap-3">
                  {tier.items.map(([name, body]) => (
                    <div class="max-w-[64ch] text-[15px] leading-relaxed text-ink-soft">
                      <span class="font-medium text-ink">{name}</span> — {body}
                    </div>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-12 flex flex-wrap items-center gap-4">
          <a href={registerUrl} target="_blank" rel="noopener noreferrer" class="doc-btn doc-btn--solid">
            Create an account ↗
          </a>
          <a
            href="/cloud"
            class="font-mono text-[13px] font-medium uppercase tracking-[0.08em] text-accent no-underline hover:underline"
          >
            Explore Veritio Cloud →
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
