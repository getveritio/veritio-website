---
/**
 * Pricing page, styled as a schedule of rates in the dossier system: a
 * hairline rate-table (plans as columns, terms as rows) instead of a SaaS card
 * row, a single "live on every plan" manifest, and a clearly fenced roadmap of
 * capabilities that exist in the plan catalog but are NOT built yet. Numbers
 * mirror veritio-cloud src/billing/plans.ts exactly — that file is the source
 * of truth; do not edit prices here without changing it there. Mono carries all
 * money and limits; serif carries prose. No client JS.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'

const registerUrl = 'https://console.getveritio.com/register'
const enterpriseMailto = 'mailto:hello@getveritio.com?subject=Veritio%20Cloud%20Enterprise'

/** Plan headers for the rate table. Prices mirror plans.ts (USD). */
const plans = [
  {
    id: 'developer',
    name: 'Developer',
    priceLead: '$0',
    priceSub: 'Free forever',
    cta: { label: 'Start free', href: registerUrl, solid: true },
  },
  {
    id: 'team',
    name: 'Team',
    priceLead: '$99',
    priceSub: '/mo · $82.50/mo billed annually',
    cta: { label: 'Create an account', href: registerUrl, solid: true },
  },
  {
    id: 'compliance',
    name: 'Compliance',
    priceLead: '$499',
    priceSub: '/mo · $415.83/mo billed annually',
    cta: { label: 'Create an account', href: registerUrl, solid: true },
  },
  {
    id: 'enterprise',
    name: 'Enterprise',
    priceLead: 'Custom',
    priceSub: 'Contact us',
    cta: { label: 'Talk to us', href: enterpriseMailto, solid: false },
  },
]

/**
 * Rate rows in plan-column order [Developer, Team, Compliance, Enterprise].
 * Values are strings so unlimited/custom read as words, not fabricated numbers.
 */
const rows = [
  { label: 'Projects', values: ['1', '3', '10', 'Unlimited'] },
  { label: 'Events / month', values: ['50,000', '500,000', '5,000,000', 'Custom'] },
  {
    label: 'Event overage',
    values: [
      'None — hard stop at cap',
      '$10 per 100k, up to 2× cap',
      '$10 per 100k, up to 2× cap',
      'Custom',
    ],
  },
  { label: 'Retention', values: ['30 days', '365 days', '5 years', 'Custom'] },
  { label: 'Export bundles', values: ['3 / month', 'Unlimited', 'Unlimited', 'Custom'] },
  { label: 'Seats included', values: ['1', '5', '25', 'Custom'] },
  { label: 'Additional seats', values: ['—', '$15 / seat / mo', '$15 / seat / mo', 'Custom'] },
]

/** Capabilities that are live NOW, identical across every plan. */
const liveFeatures = [
  {
    label: 'Hash-chained audit trail',
    body: 'Every event locked into a per-tenant sequence you (or an auditor) can re-verify.',
  },
  {
    label: 'Region choice at signup',
    body: 'Pick where your tenant data lives when you create the org — EU jurisdiction, US, or APAC.',
  },
  {
    label: 'Team invitations',
    body: 'Invite teammates into an organization with role-based access.',
  },
  {
    label: 'Signed export bundles',
    body: 'Generate signed vevb-1 evidence bundles for reviews, DSAR responses, and investigations.',
  },
  {
    label: 'Agent / AI capture',
    body: 'Record agent sessions, code changes, and deployments as first-class evidence.',
  },
  {
    label: 'Risk scoring',
    body: 'Deterministic per-step risk scores from the open veritio.reference.v1 policy.',
  },
]

/**
 * Capabilities present in the plan catalog but NOT yet built. Listed per tier
 * and clearly fenced as roadmap — never described as a shipped feature.
 */
const roadmap = [
  { plan: 'Team', items: ['Auditor role'] },
  {
    plan: 'Compliance',
    items: ['Single sign-on (SSO)', 'Auditor role', 'Dedicated signing key', 'Framework evidence annexes'],
  },
  {
    plan: 'Enterprise',
    items: ['Single sign-on (SSO)', 'Auditor role', 'Dedicated signing key', 'Framework evidence annexes'],
  },
]

const displayStyle =
  'font-size: var(--text-display); line-height: var(--text-display--line-height); letter-spacing: var(--text-display--letter-spacing);'
const headlineStyle =
  'font-size: var(--text-headline); line-height: var(--text-headline--line-height); letter-spacing: var(--text-headline--letter-spacing);'
---

<BaseLayout
  title="Pricing — Veritio Cloud"
  description="Veritio Cloud plans: Developer (free), Team, Compliance, and Enterprise. Hash-chained audit trails, region choice at signup, signed export bundles, and risk scoring on every plan. Supports compliance evidence; it does not make you compliant."
>
  <Nav />

  <main>
    <!-- COVER -->
    <section>
      <div class="container">
        <div class="border-b border-line py-3 font-mono text-[11px] uppercase tracking-[0.16em] text-ink-muted">
          Veritio Cloud · Pricing
        </div>

        <h1 class="max-w-[18ch] pt-12 font-medium text-ink sm:pt-16" style={displayStyle}>
          Managed evidence, at a rate you can read.
        </h1>

        <div class="grid gap-8 pb-12 pt-8 lg:grid-cols-[1fr_auto] lg:items-end">
          <p class="max-w-2xl text-lg leading-relaxed text-ink-soft sm:text-xl">
            Veritio Cloud is open now. Every plan runs the same open protocol —
            hash-chained audit trails, region choice at signup, signed export
            bundles, agent capture, and risk scoring — so evidence stays
            verifiable whether you self-host or let us operate it. Cloud supports
            compliance evidence; it does <em>not</em> make your organization
            compliant.
          </p>
          <p class="max-w-[26ch] font-mono text-[12px] leading-relaxed uppercase tracking-[0.1em] text-ink-muted">
            Billed annually saves two months on every paid plan.
          </p>
        </div>
      </div>
    </section>

    <!-- SCHEDULE OF PLANS -->
    <section class="border-t border-line-strong">
      <div class="container py-14 sm:py-16">
        <span class="eyebrow">Schedule of plans</span>
        <div class="mt-8 overflow-x-auto">
          <table class="w-full border-collapse text-left align-top">
            <thead>
              <tr class="border-b border-line-strong">
                <th scope="col" class="w-[168px] min-w-[150px] py-5 pr-4 align-bottom">
                  <span class="font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-ink-muted">
                    Plan
                  </span>
                </th>
                {
                  plans.map((plan) => (
                    <th scope="col" class="min-w-[188px] border-l border-line px-5 py-5 align-bottom font-normal">
                      <div class="font-serif text-[22px] font-medium leading-none text-ink">
                        {plan.name}
                      </div>
                      <div class="mt-4 font-mono text-[26px] font-medium leading-none text-ink">
                        {plan.priceLead}
                      </div>
                      <div class="mt-2 font-mono text-[11px] leading-relaxed text-ink-muted">
                        {plan.priceSub}
                      </div>
                      <a
                        href={plan.cta.href}
                        class:list={['doc-btn mt-5', plan.cta.solid && 'doc-btn--solid']}
                        {...(plan.cta.href.startsWith('http')
                          ? { target: '_blank', rel: 'noopener noreferrer' }
                          : {})}
                      >
                        {plan.cta.label}
                      </a>
                    </th>
                  ))
                }
              </tr>
            </thead>
            <tbody>
              {
                rows.map((row) => (
                  <tr class="border-b border-line">
                    <th
                      scope="row"
                      class="py-4 pr-4 text-left align-top font-mono text-[11px] font-medium uppercase tracking-[0.08em] text-accent"
                    >
                      {row.label}
                    </th>
                    {row.values.map((value) => (
                      <td class="border-l border-line px-5 py-4 align-top font-mono text-[13.5px] leading-relaxed text-ink-soft">
                        {value}
                      </td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="mt-5 max-w-[70ch] font-mono text-[11px] leading-relaxed text-ink-muted">
          Effective annual price shown per month; annual billing runs a full year
          up front for the price of ten months. Overage applies only to paid
          plans and is capped at twice the plan's monthly event allowance —
          beyond the cap, ingest fails closed rather than billing without limit.
        </p>
      </div>
    </section>

    <!-- LIVE ON EVERY PLAN -->
    <section class="border-t border-line-strong bg-surface-raised">
      <div class="container py-16 sm:py-20">
        <span class="eyebrow">Live on every plan</span>
        <h2 class="mt-4 max-w-[24ch] font-medium text-ink" style={headlineStyle}>
          The same evidence layer, at every tier.
        </h2>
        <p class="mt-5 max-w-[58ch] text-[17px] leading-relaxed text-ink-soft">
          Plans differ in volume, retention, and seats — not in what the protocol
          does. These ship today on the free Developer plan and every paid tier.
        </p>
        <dl class="mt-8 grid gap-x-12 border-t border-line-strong sm:grid-cols-2">
          {
            liveFeatures.map((feature) => (
              <div class="grid grid-cols-[1fr] gap-1 border-b border-line py-4">
                <dt class="font-mono text-[12px] font-medium uppercase tracking-[0.08em] text-accent">
                  {feature.label}
                </dt>
                <dd class="m-0 max-w-[46ch] text-[15px] leading-relaxed text-ink-soft">
                  {feature.body}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- ON THE ROADMAP -->
    <section class="border-t border-line-strong">
      <div class="container py-16 sm:py-20">
        <span class="eyebrow">On the roadmap</span>
        <h2 class="mt-4 max-w-[24ch] font-medium text-ink" style={headlineStyle}>
          Named in the catalog, not yet built.
        </h2>
        <p class="mt-5 max-w-[58ch] text-[17px] leading-relaxed text-ink-soft">
          These capabilities are part of the plan catalog but are <em>not</em>
          available yet. We list them so you know what a tier is headed toward —
          none of them is a shipped feature today.
        </p>
        <dl class="mt-8 border-t border-line-strong">
          {
            roadmap.map((tier) => (
              <div class="grid gap-2 border-b border-line py-5 sm:grid-cols-[168px_1fr] sm:gap-8">
                <dt class="font-mono text-[12px] font-medium uppercase tracking-[0.1em] text-ink-muted">
                  {tier.plan}
                </dt>
                <dd class="m-0 flex flex-wrap gap-x-6 gap-y-1 text-[15px] leading-relaxed text-ink-soft">
                  {tier.items.map((item) => (
                    <span class="whitespace-nowrap">
                      <span class="font-mono text-[11px] text-ink-muted">planned</span> {item}
                    </span>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- CLOSE -->
    <section class="border-t border-line-strong bg-evergreen">
      <div class="container py-18 sm:py-24">
        <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
          <div>
            <h2 class="max-w-[18ch] font-medium text-surface" style={headlineStyle}>
              Create an account and start recording.
            </h2>
            <p class="mt-5 max-w-[54ch] text-[17px] leading-relaxed text-surface/85">
              The Developer plan is free and needs no card — pick your region at
              signup and append your first verifiable event today. The
              open-source SDK always works on its own; Cloud is for teams that
              would rather buy the operations than staff them.
            </p>
          </div>
          <div class="flex flex-wrap items-center gap-4 lg:justify-end">
            <a
              href={registerUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="doc-btn"
              style="border-color: var(--color-surface); color: var(--color-surface);"
            >
              Create an account ↗
            </a>
            <a
              href="/cloud"
              class="font-mono text-[13px] font-medium uppercase tracking-[0.08em] text-surface/85 no-underline hover:text-surface"
            >
              Explore Veritio Cloud →
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
