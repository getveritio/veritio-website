{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static-assets Worker with one server concern: worker/index.js 301s the
  // www host to the apex (run_worker_first, see its doc comment) and defers
  // everything else to the assets binding. Custom domains below auto-create
  // the apex/www DNS records on the zone.
  "name": "veritio-website",
  "compatibility_date": "2026-07-17",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "getveritio.com",
      "custom_domain": true
    },
    {
      "pattern": "www.getveritio.com",
      "custom_domain": true
    }
  ]
}
